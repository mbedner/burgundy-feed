---
import type { TEAM_STATS } from '../config/schedule';
interface Props { stats: typeof TEAM_STATS; }
const { stats } = Astro.props;

function ordinal(n: number): string {
  const s = ['th','st','nd','rd'];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
}

const passYpg  = stats.passYardsPerGame  > 0 ? stats.passYardsPerGame.toFixed(1)  : null;
const rushYpg  = stats.rushYardsPerGame  > 0 ? stats.rushYardsPerGame.toFixed(1)  : null;
const totalYpg = (passYpg !== null && rushYpg !== null)
  ? (stats.passYardsPerGame + stats.rushYardsPerGame).toFixed(1)
  : null;
---

<div class="module">
  <div class="module-hd">Team Stats — {stats.season}</div>

  <div class="record-row">
    <span class="record" id="ts-record">{stats.record}</span>
    <span class="div-rec" id="ts-div-rec">{stats.divisionRecord} DIV</span>
  </div>

  <!-- Rank grid: offense rank, defense rank, PPG, points allowed -->
  <div class="rank-grid">
    <div class="rank-cell">
      <span class="rank-val rank-val--off" id="ts-off-rank">{ordinal(stats.offenseRank)}</span>
      <span class="rank-lbl">Off Rank</span>
    </div>
    <div class="rank-cell">
      <span class="rank-val rank-val--def" id="ts-def-rank">{ordinal(stats.defenseRank)}</span>
      <span class="rank-lbl">Def Rank</span>
    </div>
    <div class="rank-cell">
      <span class="rank-val" id="ts-ppg">{stats.pointsPerGame > 0 ? stats.pointsPerGame : '—'}</span>
      <span class="rank-lbl">PPG</span>
    </div>
    <div class="rank-cell">
      <span class="rank-val" id="ts-opp-ppg">{stats.pointsAllowed > 0 ? stats.pointsAllowed : '—'}</span>
      <span class="rank-lbl">Opp PPG</span>
    </div>
  </div>

  <!-- Yards per game breakdown -->
  <div class="yards-grid">
    <div class="yards-cell">
      <span class="yards-val" id="ts-pass-ypg">{passYpg ?? '—'}</span>
      <span class="yards-lbl">Pass Yds/G</span>
    </div>
    <div class="yards-cell">
      <span class="yards-val" id="ts-rush-ypg">{rushYpg ?? '—'}</span>
      <span class="yards-lbl">Rush Yds/G</span>
    </div>
    <div class="yards-cell yards-cell--total">
      <span class="yards-val" id="ts-total-ypg">{totalYpg ?? '—'}</span>
      <span class="yards-lbl">Total Yds/G</span>
    </div>
  </div>

  <!-- Season leaders -->
  <div class="leaders">
    {[
      { key: 'passingYards',   label: 'Passing Yards'   },
      { key: 'rushingYards',   label: 'Rushing Yards'   },
      { key: 'receivingYards', label: 'Receiving Yards' },
      { key: 'sacks',          label: 'Sacks'           },
      { key: 'interceptions',  label: 'Interceptions'   },
      { key: 'tackles',        label: 'Tackles'         },
    ].map(({ key, label }) => (
      <div class="leader-row">
        <span class="leader-cat">{label}</span>
        <div class="leader-right">
          <span class="leader-name" id={`ts-leader-${key}-name`}>{(stats.leaders as any)[key]?.name ?? '—'}</span>
          <span class="leader-stat" id={`ts-leader-${key}-stat`}>{(stats.leaders as any)[key]?.stat ?? '—'}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="stats-footer" id="ts-footer" style="display:none">
    <span class="live-badge" id="ts-footer-label">Stats provided by ESPN</span>
  </div>
</div>

<script>
(async () => {
  const BASE    = 'https://site.api.espn.com/apis/site/v2/sports/football/nfl';
  const CORE    = 'https://sports.core.api.espn.com/v2/sports/football/leagues/nfl';
  const TEAM_ID = '28';
  const now        = new Date();
  const seasonYear = now.getMonth() >= 7 ? now.getFullYear() : now.getFullYear() - 1;

  function set(id: string, val: string | number) {
    const el = document.getElementById(id);
    if (el && val !== undefined && val !== null) el.textContent = String(val);
  }

  function ordinal(n: number): string {
    const s = ['th','st','nd','rd'];
    const v = n % 100;
    return n + (s[(v - 20) % 10] || s[v] || s[0]);
  }

  function fmtNum(n: number): string { return n % 1 === 0 ? String(Math.round(n)) : n.toFixed(1); }

  function catStat(categories: any[], catName: string, statName: string): { val: number; display: string } {
    const cat = categories.find((c: any) => c.name === catName);
    const s   = cat?.stats?.find((st: any) => st.name === statName);
    return { val: parseFloat(s?.value ?? s?.displayValue ?? '0') || 0, display: s?.displayValue ?? '—' };
  }

  // ── Phase 1: team-level stats (record, yards/game, PPG, standings) ───────────
  const [teamRes, statsRes, standRes] = await Promise.allSettled([
    fetch(`${BASE}/teams/${TEAM_ID}`).then(r => r.json()),
    fetch(`${CORE}/seasons/${seasonYear}/types/2/teams/${TEAM_ID}/statistics`).then(r => r.json()),
    fetch(`https://site.api.espn.com/apis/v2/sports/football/nfl/standings?season=${seasonYear}`).then(r => r.json()),
  ]);

  if (teamRes.status === 'fulfilled') {
    const items: any[] = teamRes.value?.team?.record?.items ?? [];
    const overall  = items[0];
    const division = items.find((r: any) => r.name?.toLowerCase().includes('div'));
    if (overall?.summary)  set('ts-record',  overall.summary);
    if (division?.summary) set('ts-div-rec', division.summary + ' DIV');
  }

  let espnHasStats = false;
  if (statsRes.status === 'fulfilled') {
    const cats: any[] = statsRes.value?.splits?.categories ?? [];
    const passYpg = catStat(cats, 'passing', 'passingYardsPerGame').val;
    const rushYpg = catStat(cats, 'rushing', 'rushingYardsPerGame').val;
    const ppg     = catStat(cats, 'scoring', 'totalPointsPerGame').val;

    // Only update from ESPN if at least one meaningful value came back
    if (passYpg > 0 || rushYpg > 0) {
      set('ts-pass-ypg',  fmtNum(passYpg));
      set('ts-rush-ypg',  fmtNum(rushYpg));
      set('ts-total-ypg', fmtNum(passYpg + rushYpg));
      espnHasStats = true;
    } else {
      // Season started but no yardage data yet — clear zeros to dashes
      const passEl = document.getElementById('ts-pass-ypg');
      const rushEl = document.getElementById('ts-rush-ypg');
      const totEl  = document.getElementById('ts-total-ypg');
      if (passEl?.textContent === '0' || passEl?.textContent === '0.0') passEl.textContent = '—';
      if (rushEl?.textContent === '0' || rushEl?.textContent === '0.0') rushEl.textContent = '—';
      if (totEl?.textContent === '0' || totEl?.textContent === '0.0')   totEl.textContent  = '—';
    }
    if (ppg > 0) {
      set('ts-ppg', fmtNum(ppg));
      espnHasStats = true;
    }
  }

  if (standRes.status === 'fulfilled') {
    const entries: any[] = standRes.value?.standings?.entries ?? [];
    const wasEntry = entries.find((e: any) => e?.team?.id === TEAM_ID);
    if (wasEntry) {
      let offRank = 0, defRank = 0, oppPpg = 0;
      for (const s of wasEntry?.stats ?? []) {
        if (s.name === 'pointsFor')     offRank = s.rank ?? 0;
        if (s.name === 'pointsAgainst') { defRank = s.rank ?? 0; oppPpg = parseFloat(s.displayValue) || 0; }
      }
      if (offRank) set('ts-off-rank', ordinal(offRank));
      if (defRank) set('ts-def-rank', ordinal(defRank));
      if (oppPpg)  set('ts-opp-ppg',  fmtNum(oppPpg));
    }
  }

  // ── Phase 2: player stat leaders ─────────────────────────────────────────────
  try {
    const rosterData = await fetch(`${BASE}/teams/${TEAM_ID}/roster`).then(r => r.json()) as any;

    const SKILL_OFF = new Set(['QB','RB','WR','TE']);
    const SKILL_DEF = new Set(['DE','OLB','LB','CB','S']);

    const players: { id: string; name: string; pos: string }[] = [];
    for (const group of rosterData?.athletes ?? []) {
      if (!['offense','defense'].includes(group.position)) continue;
      for (const a of group.items ?? []) {
        const pos: string = a.position?.abbreviation ?? '';
        if (SKILL_OFF.has(pos) || SKILL_DEF.has(pos)) {
          players.push({ id: a.id, name: a.fullName ?? a.displayName, pos });
        }
      }
    }

    // Fetch each player's season stats in parallel
    const results = await Promise.allSettled(
      players.map(p =>
        fetch(`${CORE}/seasons/${seasonYear}/types/2/athletes/${p.id}/statistics/0`)
          .then(r => r.json())
          .then((d: any) => ({ ...p, cats: d?.splits?.categories ?? [] }))
      )
    );

    const withStats = results
      .filter(r => r.status === 'fulfilled')
      .map(r => (r as PromiseFulfilledResult<any>).value)
      .filter(p => p.cats.length > 0);

    function findLeader(
      pool: typeof withStats,
      catName: string,
      statNames: string[],   // try in order
      fmt?: (v: number, d: string) => string
    ): { name: string; stat: string } | null {
      let best: { name: string; val: number; display: string } | null = null;
      for (const p of pool) {
        for (const sn of statNames) {
          const { val, display } = catStat(p.cats, catName, sn);
          if (val > 0 && (!best || val > best.val)) {
            best = { name: p.name, val, display: fmt ? fmt(val, display) : display };
          }
        }
      }
      return best && best.val > 0 ? { name: best.name, stat: best.display } : null;
    }

    const off = withStats.filter(p => SKILL_OFF.has(p.pos));
    const def = withStats.filter(p => SKILL_DEF.has(p.pos));

    const leaders: Record<string, { name: string; stat: string } | null> = {
      passingYards:   findLeader(off.filter(p => p.pos === 'QB'),                'passing',              ['passingYards'],                 (v) => `${v} YDS`),
      rushingYards:   findLeader(off.filter(p => ['RB','QB'].includes(p.pos)),   'rushing',              ['rushingYards'],                 (v) => `${v} YDS`),
      receivingYards: findLeader(off.filter(p => ['WR','TE','RB'].includes(p.pos)), 'receiving',         ['receivingYards'],               (v) => `${v} YDS`),
      sacks:          findLeader(def.filter(p => ['DE','OLB','LB'].includes(p.pos)), 'defensive',        ['sacks'],                       (v, d) => d),
      interceptions:  findLeader(def,                                             'defensiveInterceptions', ['interceptions'],             (v, d) => d),
      tackles:        findLeader(def,                                             'defensive',            ['totalTackles','tackles'],       (v, d) => d),
    };

    for (const [key, leader] of Object.entries(leaders)) {
      if (!leader) continue;
      set(`ts-leader-${key}-name`, leader.name);
      set(`ts-leader-${key}-stat`, leader.stat);
      // Hide the row if we couldn't find a valid stat
      if (!leader) {
        const row = document.getElementById(`ts-leader-${key}-name`)?.closest('.leader-row') as HTMLElement | null;
        if (row) row.style.display = 'none';
      }
    }
  } catch { /* leader fetch failed — fallback names stay */ }

  const footer = document.getElementById('ts-footer');
  if (footer) {
    // Only show ESPN attribution if we received at least some live data
    if (espnHasStats) {
      footer.style.display = '';
    }
  }
})();
</script>

<style>
  .module-hd {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 14px;
  }
  .record-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 14px;
  }
  .record {
    font-family: var(--font-display, 'Barlow Condensed', 'Arial Narrow', sans-serif);
    font-size: 34px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1;
  }
  .div-rec {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-3);
    letter-spacing: 0.04em;
  }

  /* ── Rank grid ── */
  .rank-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    background: var(--surface-2);
    margin-bottom: 10px;
    border-radius: 0;
    overflow: hidden;
  }
  .rank-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px 4px;
    border-right: 1px solid var(--border);
    gap: 2px;
  }
  .rank-cell:last-child { border-right: none; }
  .rank-val {
    font-family: var(--font-display, 'Barlow Condensed', 'Arial Narrow', sans-serif);
    font-size: 16px;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
  }
  .rank-val--off { color: var(--gold); }
  .rank-val--def { color: var(--gold); }
  .rank-lbl {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-3);
    font-weight: 600;
    text-align: center;
  }

  /* ── Yards grid ── */
  .yards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--border);
    background: var(--surface-2);
    margin-bottom: 16px;
    border-radius: 0;
    overflow: hidden;
  }
  .yards-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 7px 4px;
    border-right: 1px solid var(--border);
    gap: 2px;
  }
  .yards-cell:last-child { border-right: none; }
  .yards-cell--total { background: var(--surface-3); }
  .yards-val {
    font-family: var(--font-display, 'Barlow Condensed', 'Arial Narrow', sans-serif);
    font-size: 15px;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .yards-lbl {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-3);
    font-weight: 600;
    text-align: center;
  }

  /* ── Leaders ── */
  .leaders { display: flex; flex-direction: column; gap: 0; margin-bottom: 0; }
  .leader-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 0;
    border-bottom: 1px solid var(--border);
  }
  .leader-cat {
    font-size: 11px;
    color: var(--text-3);
    white-space: nowrap;
    min-width: 100px;
    text-transform: capitalize;
  }
  .leader-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
  }
  .leader-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--text);
    text-align: right;
  }
  .leader-stat {
    font-size: 11px;
    color: var(--text-3);
    text-align: right;
  }

  .stats-footer {
    font-size: 10px;
    color: var(--text-4);
    text-align: right;
    margin-top: 6px;
  }
  .live-badge { color: var(--text-4); font-weight: 500; }
</style>
