---
import type { TEAM_STATS } from '../config/schedule';
import type { FEATURED_PLAYERS } from '../config/players';
interface Props { stats: typeof TEAM_STATS; players: typeof FEATURED_PLAYERS; }
const { stats, players } = Astro.props;

function ordinal(n: number): string {
  const s = ['th','st','nd','rd'];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
}

const totalYards = (stats.passYardsPerGame + stats.rushYardsPerGame).toFixed(1);
---

<div class="module">
  <div class="module-hd">Team Stats — {stats.season}</div>

  <div class="record-row">
    <span class="record" id="ts-record">{stats.record}</span>
    <span class="div-rec" id="ts-div-rec">{stats.divisionRecord} DIV</span>
  </div>

  <!-- Rank grid: offense rank, defense rank, PPG, points allowed -->
  <div class="rank-grid">
    <div class="rank-cell">
      <span class="rank-val rank-val--off" id="ts-off-rank">{ordinal(stats.offenseRank)}</span>
      <span class="rank-lbl">Off Rank</span>
    </div>
    <div class="rank-cell">
      <span class="rank-val rank-val--def" id="ts-def-rank">{ordinal(stats.defenseRank)}</span>
      <span class="rank-lbl">Def Rank</span>
    </div>
    <div class="rank-cell">
      <span class="rank-val" id="ts-ppg">{stats.pointsPerGame}</span>
      <span class="rank-lbl">PPG</span>
    </div>
    <div class="rank-cell">
      <span class="rank-val" id="ts-opp-ppg">{stats.pointsAllowed}</span>
      <span class="rank-lbl">Opp PPG</span>
    </div>
  </div>

  <!-- Yards per game breakdown -->
  <div class="yards-grid">
    <div class="yards-cell">
      <span class="yards-val" id="ts-pass-ypg">{stats.passYardsPerGame}</span>
      <span class="yards-lbl">Pass Yds/G</span>
    </div>
    <div class="yards-cell">
      <span class="yards-val" id="ts-rush-ypg">{stats.rushYardsPerGame}</span>
      <span class="yards-lbl">Rush Yds/G</span>
    </div>
    <div class="yards-cell yards-cell--total">
      <span class="yards-val" id="ts-total-ypg">{totalYards}</span>
      <span class="yards-lbl">Total Yds/G</span>
    </div>
  </div>

  <!-- Season leaders -->
  <div class="leaders">
    {Object.entries(stats.leaders).map(([key, val]) => (
      <div class="leader-row">
        <span class="leader-cat">{key.replace(/([A-Z])/g, ' $1').trim()}</span>
        <div class="leader-right">
          <span class="leader-name">{val.name}</span>
          <span class="leader-stat">{val.stat}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Player spotlight -->
  {players.length > 0 && (
    <div class="spotlight">
      <div class="spotlight-hd">Spotlight</div>
      {players.map(p => (
        <div class="player-row">
          <span class="player-num">#{p.number}</span>
          <div class="player-info">
            <span class="player-name">{p.name}</span>
            <span class="player-note">{p.note}</span>
          </div>
          <span class="player-pos">{p.position}</span>
        </div>
      ))}
    </div>
  )}

  <div class="stats-footer" id="ts-footer" style="display:none">
    <span class="live-badge">● Live via ESPN</span>
  </div>
</div>

<script>
(async () => {
  const BASE    = 'https://site.api.espn.com/apis/site/v2/sports/football/nfl';
  const CORE    = 'https://sports.core.api.espn.com/v2/sports/football/leagues/nfl';
  const TEAM_ID = '28';

  function set(id: string, val: string | number) {
    const el = document.getElementById(id);
    if (el && val !== undefined && val !== null) el.textContent = String(val);
  }

  function ordinal(n: number): string {
    const s = ['th','st','nd','rd'];
    const v = n % 100;
    return n + (s[(v - 20) % 10] || s[v] || s[0]);
  }

  function getStat(categories: any[], catName: string, statName: string): number {
    const cat = categories.find((c: any) => c.name === catName);
    const s   = cat?.stats?.find((s: any) => s.name === statName);
    return s ? parseFloat(s.displayValue) || 0 : 0;
  }

  try {
    const now        = new Date();
    const seasonYear = now.getMonth() >= 7 ? now.getFullYear() : now.getFullYear() - 1;

    const [teamRes, statsRes, standRes] = await Promise.all([
      fetch(`${BASE}/teams/${TEAM_ID}`),
      fetch(`${CORE}/seasons/${seasonYear}/types/2/teams/${TEAM_ID}/statistics`),
      fetch(`https://site.api.espn.com/apis/v2/sports/football/nfl/standings?season=${seasonYear}`),
    ]);

    // ── Record ────────────────────────────────────────────────────────────────
    if (teamRes.ok) {
      const td = await teamRes.json() as any;
      const items: any[] = td?.team?.record?.items ?? [];
      const overall = items.find((r: any) => !r.name || r.name === 'overall' || items.indexOf(r) === 0);
      const division = items.find((r: any) => r.name?.toLowerCase().includes('div'));
      if (overall?.summary)  set('ts-record',  overall.summary);
      if (division?.summary) set('ts-div-rec', division.summary + ' DIV');
    }

    // ── Team stats (yards/game, PPG) ──────────────────────────────────────────
    if (statsRes.ok) {
      const sd = await statsRes.json() as any;
      const cats: any[] = sd?.splits?.categories ?? [];

      const passYpg  = getStat(cats, 'passing', 'passingYardsPerGame');
      const rushYpg  = getStat(cats, 'rushing', 'rushingYardsPerGame');
      const ppg      = getStat(cats, 'scoring', 'totalPointsPerGame');

      if (passYpg)  set('ts-pass-ypg',  passYpg.toFixed(1));
      if (rushYpg)  set('ts-rush-ypg',  rushYpg.toFixed(1));
      if (passYpg || rushYpg) set('ts-total-ypg', (passYpg + rushYpg).toFixed(1));
      if (ppg)      set('ts-ppg',        ppg.toFixed(1));
    }

    // ── Standings (ranks + opp PPG) ───────────────────────────────────────────
    if (standRes.ok) {
      const standData = await standRes.json() as any;
      const entries: any[] = standData?.standings?.entries ?? [];
      const wasEntry = entries.find((e: any) => e?.team?.id === TEAM_ID);
      if (wasEntry) {
        let offRank = 0, defRank = 0, oppPpg = 0;
        for (const s of wasEntry?.stats ?? []) {
          if (s.name === 'pointsFor')     offRank = s.rank ?? 0;
          if (s.name === 'pointsAgainst') { defRank = s.rank ?? 0; oppPpg = parseFloat(s.displayValue) || 0; }
        }
        if (offRank) set('ts-off-rank', ordinal(offRank));
        if (defRank) set('ts-def-rank', ordinal(defRank));
        if (oppPpg)  set('ts-opp-ppg',  oppPpg.toFixed(1));
      }
    }

    // Show live badge if any fetch succeeded
    const footer = document.getElementById('ts-footer');
    if (footer) footer.style.display = '';

  } catch { /* silent — fallback data stays */ }
})();
</script>

<style>
  .module-hd {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 14px;
  }
  .record-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 14px;
  }
  .record {
    font-family: var(--font-display, 'Barlow Condensed', 'Arial Narrow', sans-serif);
    font-size: 34px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1;
  }
  .div-rec {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-3);
    letter-spacing: 0.04em;
  }

  /* ── Rank grid ── */
  .rank-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    background: var(--surface-2);
    margin-bottom: 10px;
    border-radius: 0;
    overflow: hidden;
  }
  .rank-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px 4px;
    border-right: 1px solid var(--border);
    gap: 2px;
  }
  .rank-cell:last-child { border-right: none; }
  .rank-val {
    font-family: var(--font-display, 'Barlow Condensed', 'Arial Narrow', sans-serif);
    font-size: 16px;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
  }
  .rank-val--off { color: var(--gold); }
  .rank-val--def { color: var(--gold); }
  .rank-lbl {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-3);
    font-weight: 600;
    text-align: center;
  }

  /* ── Yards grid ── */
  .yards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--border);
    background: var(--surface-2);
    margin-bottom: 16px;
    border-radius: 0;
    overflow: hidden;
  }
  .yards-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 7px 4px;
    border-right: 1px solid var(--border);
    gap: 2px;
  }
  .yards-cell:last-child { border-right: none; }
  .yards-cell--total { background: var(--surface-3); }
  .yards-val {
    font-family: var(--font-display, 'Barlow Condensed', 'Arial Narrow', sans-serif);
    font-size: 15px;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .yards-lbl {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-3);
    font-weight: 600;
    text-align: center;
  }

  /* ── Leaders ── */
  .leaders { display: flex; flex-direction: column; gap: 0; margin-bottom: 0; }
  .leader-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 0;
    border-bottom: 1px solid var(--border);
  }
  .leader-cat {
    font-size: 11px;
    color: var(--text-3);
    white-space: nowrap;
    min-width: 100px;
    text-transform: capitalize;
  }
  .leader-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
  }
  .leader-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--text);
    text-align: right;
  }
  .leader-stat {
    font-size: 11px;
    color: var(--text-3);
    text-align: right;
  }

  /* ── Spotlight ── */
  /* No border-top here — spacing alone separates it from leaders */
  .spotlight {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .spotlight-hd {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 10px;
  }
  .player-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
  }
  .player-num {
    font-size: 11px;
    font-weight: 800;
    color: var(--accent);
    width: 26px;
    flex-shrink: 0;
  }
  .player-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .player-name { font-size: 13px; font-weight: 700; color: var(--text); }
  .player-note { font-size: 11px; color: var(--text-3); font-style: italic; }
  .player-pos {
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 2px 5px;
    border-radius: 3px;
  }

  .stats-footer {
    font-size: 10px;
    color: var(--text-4);
    text-align: right;
    margin-top: 6px;
  }
  .live-badge { color: var(--live-dot); font-weight: 600; }
</style>
