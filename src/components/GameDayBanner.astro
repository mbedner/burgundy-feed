---
import type { GameDayInfo } from '../lib/gameday';

interface Props { game: GameDayInfo; }
const { game } = Astro.props;

const { phase, washington, opponent, period, periodDisplay, clock,
        situation, recentPlays, scoringPlays, kickoffDisplay,
        network, venue, kickoffIso, gameId, boxScore } = game;

const wasWon  = phase === 'postgame' && washington.winner;
const wasLost = phase === 'postgame' && !washington.winner &&
                washington.score !== opponent.score;
const oppWon  = phase === 'postgame' && !washington.winner &&
                washington.score !== opponent.score;

const wasColor = `#${washington.color || '9b1535'}`;
const oppColor = `#${opponent.color || '5a5a5a'}`;

const hasBoxScore = phase === 'postgame' && !!boxScore;
const hasPlays    = phase === 'live' || phase === 'halftime' || phase === 'postgame';
---

<div class="gd-banner" id="gdBanner" data-game-id={gameId} data-phase={phase}
     style={`--was-color:${wasColor};--opp-color:${oppColor}`}>

  {/* ── Score bar ── */}
  <div class="gd-scorebar">

    <div class="gd-team gd-team--was">
      {washington.logo && (
        <img class="gd-logo" src={washington.logo} alt="WAS" loading="eager" />
      )}
      <div class="gd-team-text">
        <span class="gd-abbr">WAS</span>
        <div class={`gd-score-wrap${wasLost ? ' gd-score-wrap--dim' : ''}`}>
          {wasWon && <span class="gd-caret" aria-hidden="true">▸</span>}
          <span class="gd-score" id="gdWasScore">{washington.score}</span>
        </div>
      </div>
    </div>

    <div class="gd-middle">
      {phase === 'pregame' && (
        <div class="gd-pregame-info">
          <span class="gd-phase-label">GAME DAY</span>
          <span class="gd-kickoff">{kickoffDisplay}</span>
          {network && <span class="gd-network">{network}</span>}
          {venue   && <span class="gd-venue">{venue}</span>}
        </div>
      )}
      {(phase === 'live' || phase === 'halftime') && (
        <div class="gd-live-info">
          <span class="gd-live-dot"></span>
          <span class="gd-period" id="gdPeriod">
            {phase === 'halftime' ? 'HALF' : periodDisplay}
          </span>
          {phase === 'live' && (
            <span class="gd-clock" id="gdClock">{clock}</span>
          )}
        </div>
      )}
      {phase === 'postgame' && (
        <div class="gd-final-info">
          <span class="gd-final-label">FINAL</span>
        </div>
      )}
    </div>

    <div class="gd-team gd-team--opp">
      <div class="gd-team-text gd-team-text--opp">
        <span class="gd-abbr">{opponent.abbreviation}</span>
        <div class={`gd-score-wrap${wasWon ? ' gd-score-wrap--dim' : ''}`}>
          {oppWon && <span class="gd-caret" aria-hidden="true">▸</span>}
          <span class="gd-score" id="gdOppScore">{opponent.score}</span>
        </div>
      </div>
      {opponent.logo && (
        <img class="gd-logo" src={opponent.logo} alt={opponent.abbreviation} loading="eager" />
      )}
    </div>

  </div>

  {/* ── Situation bar (live only) ── */}
  {phase === 'live' && situation && (
    <div class="gd-situation" id="gdSituation">
      <span class="gd-possession">
        {situation.isWashingtonPossession ? '🏈 WAS' : `🏈 ${opponent.abbreviation}`}
      </span>
      <span class="gd-down-dist">{situation.downDistanceText}</span>
    </div>
  )}

  {/* ── Countdown (pregame only) ── */}
  {phase === 'pregame' && (
    <div class="gd-countdown">
      <span id="gdCountdown" data-kickoff={kickoffIso}>Kickoff soon</span>
    </div>
  )}

  {/* ── Tabs + panels (live / halftime / postgame) ── */}
  {hasPlays && (
    <>
      <div class="gd-tabs" role="tablist">
        <button class="gd-tab gd-tab--active" role="tab" aria-selected="true"
                data-target="gdPanelSummary">
          {phase === 'postgame' ? 'Scoring' : 'Plays'}
        </button>
        {hasBoxScore && (
          <button class="gd-tab" role="tab" aria-selected="false"
                  data-target="gdPanelStats">
            Stats
          </button>
        )}
      </div>

      <div class="gd-panel" id="gdPanelSummary" role="tabpanel">
        <div class="gd-plays-list" id="gdPlaysList">
          {(phase === 'postgame' ? scoringPlays : recentPlays).map(play => (
            <div class={`gd-play${play.isScoring ? ' gd-play--scoring' : ''}`}>
              <span class="gd-play-meta">
                {play.isScoring && play.scoringType && (
                  <span class="gd-play-score-type">{play.scoringType}</span>
                )}
                <span class="gd-play-period">Q{play.period}</span>
                <span class="gd-play-clock">{play.clock}</span>
              </span>
              <span class="gd-play-text">{play.text}</span>
            </div>
          ))}
        </div>
      </div>

      {hasBoxScore && (
        <div class="gd-panel" id="gdPanelStats" hidden role="tabpanel">
          {boxScore!.passing.length > 0 && (
            <div class="gd-bs-group">
              <div class="gd-bs-cat">Passing</div>
              {boxScore!.passing.map(p => (
                <div class="gd-bs-row">
                  <span class="gd-bs-name">{p.shortName}</span>
                  <span class="gd-bs-stats">
                    {p.labels.map((lbl, i) => (
                      <span class="gd-bs-cell">
                        <span class="gd-bs-val">{p.stats[i]}</span>
                        <span class="gd-bs-lbl">{lbl}</span>
                      </span>
                    ))}
                  </span>
                </div>
              ))}
            </div>
          )}
          {boxScore!.rushing.length > 0 && (
            <div class="gd-bs-group">
              <div class="gd-bs-cat">Rushing</div>
              {boxScore!.rushing.map(p => (
                <div class="gd-bs-row">
                  <span class="gd-bs-name">{p.shortName}</span>
                  <span class="gd-bs-stats">
                    {p.labels.map((lbl, i) => (
                      <span class="gd-bs-cell">
                        <span class="gd-bs-val">{p.stats[i]}</span>
                        <span class="gd-bs-lbl">{lbl}</span>
                      </span>
                    ))}
                  </span>
                </div>
              ))}
            </div>
          )}
          {boxScore!.receiving.length > 0 && (
            <div class="gd-bs-group">
              <div class="gd-bs-cat">Receiving</div>
              {boxScore!.receiving.map(p => (
                <div class="gd-bs-row">
                  <span class="gd-bs-name">{p.shortName}</span>
                  <span class="gd-bs-stats">
                    {p.labels.map((lbl, i) => (
                      <span class="gd-bs-cell">
                        <span class="gd-bs-val">{p.stats[i]}</span>
                        <span class="gd-bs-lbl">{lbl}</span>
                      </span>
                    ))}
                  </span>
                </div>
              ))}
            </div>
          )}
          {boxScore!.defensive.length > 0 && (
            <div class="gd-bs-group">
              <div class="gd-bs-cat">Defense</div>
              {boxScore!.defensive.slice(0, 3).map(p => (
                <div class="gd-bs-row">
                  <span class="gd-bs-name">{p.shortName}</span>
                  <span class="gd-bs-stats">
                    {p.labels.map((lbl, i) => (
                      <span class="gd-bs-cell">
                        <span class="gd-bs-val">{p.stats[i]}</span>
                        <span class="gd-bs-lbl">{lbl}</span>
                      </span>
                    ))}
                  </span>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </>
  )}

</div>

{/* ── Tab switching ── */}
<script>
  function initGdTabs(banner: Element) {
    banner.querySelectorAll<HTMLButtonElement>('.gd-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        banner.querySelectorAll('.gd-tab').forEach(t => {
          t.classList.toggle('gd-tab--active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        banner.querySelectorAll<HTMLElement>('.gd-panel').forEach(panel => {
          panel.hidden = panel.id !== target;
        });
      });
    });
  }
  const gdBanner = document.getElementById('gdBanner');
  if (gdBanner) initGdTabs(gdBanner);
</script>

{/* ── Client-side live updater (SSR-rendered live/halftime games) ── */}
{(phase === 'live' || phase === 'halftime') ? (
  <script define:vars={{ gameId, POLL_MS: 30000 }}>
    const ESPN_URL = `https://site.api.espn.com/apis/site/v2/sports/football/nfl/summary?event=${gameId}`;
    const WAS_ID = '28';

    async function pollGame() {
      try {
        const res = await fetch(ESPN_URL);
        if (!res.ok) return;
        const data = await res.json();

        const headerComp = data?.header?.competitions?.[0];
        const status     = headerComp?.status;
        const state      = status?.type?.state;

        const competitors = headerComp?.competitors ?? [];
        const was = competitors.find(c => c.id === WAS_ID);
        const opp = competitors.find(c => c.id !== WAS_ID);
        if (was) document.getElementById('gdWasScore').textContent = was.score ?? '0';
        if (opp) document.getElementById('gdOppScore').textContent = opp.score ?? '0';

        const period = status?.period ?? 1;
        const clock  = status?.displayClock ?? '0:00';
        const isHalf = status?.type?.description?.toLowerCase().includes('halftime');
        const isPost = state === 'post';

        const periodEl = document.getElementById('gdPeriod');
        const clockEl  = document.getElementById('gdClock');
        if (periodEl) periodEl.textContent = isHalf ? 'HALF' : period > 4 ? `OT` : `Q${period}`;
        if (clockEl)  clockEl.textContent  = clock;

        const sit = data?.header?.competitions?.[0]?.situation ?? null;
        const sitEl = document.getElementById('gdSituation');
        if (sitEl && sit) {
          sitEl.querySelector('.gd-possession').textContent =
            sit.possessionTeam?.id === WAS_ID ? '🏈 WAS' :
            `🏈 ${opp?.team?.abbreviation ?? 'OPP'}`;
          sitEl.querySelector('.gd-down-dist').textContent = sit.downDistanceText ?? '';
        }

        const drives = data?.drives ?? {};
        const plays = [];
        const curr = [...(drives?.current?.plays ?? [])].reverse();
        for (const p of curr) plays.push(p);
        const prev = drives?.previous ?? [];
        for (const d of [...prev].reverse()) {
          for (const p of [...(d.plays ?? [])].reverse()) {
            plays.push(p);
            if (plays.length >= 10) break;
          }
          if (plays.length >= 10) break;
        }

        const listEl = document.getElementById('gdPlaysList');
        if (listEl && plays.length) {
          const scoreTypeMap = { '67':'TD','68':'TD','72':'TD','59':'FG','63':'FG','70':'Safety','57':'XP','58':'XP','69':'2PT' };
          listEl.innerHTML = plays.slice(0, 10).map(p => {
            const isScore = !!p.scoringPlay;
            const sType = scoreTypeMap[p?.type?.id ?? ''] ?? '';
            return `<div class="gd-play${isScore ? ' gd-play--scoring' : ''}">
              <span class="gd-play-meta">
                ${isScore && sType ? `<span class="gd-play-score-type">${sType}</span>` : ''}
                <span class="gd-play-period">Q${p?.period?.number ?? ''}</span>
                <span class="gd-play-clock">${p?.clock?.displayValue ?? ''}</span>
              </span>
              <span class="gd-play-text">${p?.text ?? ''}</span>
            </div>`;
          }).join('');
        }

        if (isPost) { window.location.reload(); return; }
      } catch { /* silent */ }
    }

    setInterval(pollGame, POLL_MS);
  </script>
) : null}

{/* ── Pregame countdown ── */}
{phase === 'pregame' ? (
  <script>
    const el = document.getElementById('gdCountdown');
    if (el) {
      const kickoff = new Date(el.dataset.kickoff);
      function updateCountdown() {
        const diff = kickoff - Date.now();
        if (diff <= 0) { el.textContent = 'Kickoff!'; return; }
        const h = Math.floor(diff / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        el.textContent = h > 0 ? `Kickoff in ${h}h ${m}m` : `Kickoff in ${m}m`;
      }
      updateCountdown();
      setInterval(updateCountdown, 30000);
    }
  </script>
) : null}

<style is:global>
  /* ── Theme tokens (light default) ── */
  .gd-banner {
    --gd-bg:           #ffffff;
    --gd-bg2:          #f4f3f1;
    --gd-bg3:          #ffffff;
    --gd-score-mid:    #ffffff;
    --gd-border:       #e0ddd8;
    --gd-border2:      #eae8e4;
    --gd-text:         #1a1918;
    --gd-text2:        #48453f;
    --gd-text3:        #787470;
    --gd-text4:        #9a9890;
    --gd-text5:        #888480;
    --gd-abbr:         #888078;
    --gd-name:         #2e2c28;
    --gd-scoring-bg:   #ffffff;
    --gd-scoring-bdr:  var(--gd-border2);
  }

  /* Dark overrides */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .gd-banner {
      --gd-bg:          #0f0f0f;
      --gd-bg2:         #141414;
      --gd-bg3:         #1a1a1a;
      --gd-score-mid:   #141414;
      --gd-border:      #2a2a2a;
      --gd-border2:     #1e1e1e;
      --gd-text:        #f0eeeb;
      --gd-text2:       #c0b8b0;
      --gd-text3:       #9a9080;
      --gd-text4:       #7a7068;
      --gd-text5:       #6a6058;
      --gd-abbr:        #a09890;
      --gd-name:        #d0c8c0;
      --gd-scoring-bg:  #1a1200;
      --gd-scoring-bdr: #2a2000;
    }
  }
  :root[data-theme="dark"] .gd-banner {
    --gd-bg:          #0f0f0f;
    --gd-bg2:         #141414;
    --gd-bg3:         #1a1a1a;
    --gd-score-mid:   #141414;
    --gd-border:      #2a2a2a;
    --gd-border2:     #1e1e1e;
    --gd-text:        #f0eeeb;
    --gd-text2:       #c0b8b0;
    --gd-text3:       #9a9080;
    --gd-text4:       #7a7068;
    --gd-text5:       #6a6058;
    --gd-abbr:        #a09890;
    --gd-name:        #d0c8c0;
    --gd-scoring-bg:  #1a1200;
    --gd-scoring-bdr: #2a2000;
  }

  /* ── Banner shell ── */
  .gd-banner {
    background: var(--gd-bg);
    border: 1px solid var(--gd-border);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 20px;
    color: var(--gd-text);
  }

  /* ── Score bar ── */
  .gd-scorebar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: linear-gradient(to right,
      var(--was-color, #5a1414) 0px 5px,
      var(--gd-score-mid) 5px calc(100% - 5px),
      var(--opp-color, #333333) calc(100% - 5px)
    );
  }

  .gd-team {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .gd-team--was { justify-content: flex-start; }
  .gd-team--opp { justify-content: flex-end;   }

  .gd-logo {
    width: 42px;
    height: 42px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .gd-team-text {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
  }
  .gd-team-text--opp { align-items: flex-start; }

  .gd-abbr {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gd-abbr);
    line-height: 1;
  }
  .gd-team--was .gd-abbr { color: #e8a820; }

  /* Score with optional caret */
  .gd-score-wrap {
    position: relative;
  }
  .gd-score-wrap--dim { opacity: 0.38; }

  /* Caret is absolutely positioned so it never shifts the score number */
  .gd-caret {
    position: absolute;
    right: calc(100% + 2px);
    top: 50%;
    transform: translateY(-50%);
    font-size: 14px;
    color: #e8a820;
    line-height: 1;
  }

  .gd-score {
    font-size: 38px;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--gd-text);
  }

  /* ── Middle section ── */
  .gd-middle {
    text-align: center;
    min-width: 60px;
  }

  .gd-pregame-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .gd-phase-label {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #e8a820;
  }
  .gd-kickoff {
    font-size: 13px;
    font-weight: 700;
    color: var(--gd-text);
  }
  .gd-network,
  .gd-venue { font-size: 10px; color: var(--gd-text3); }

  .gd-live-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .gd-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ef4444;
    animation: gd-blink 1.2s ease-in-out infinite;
    margin-bottom: 2px;
  }
  @keyframes gd-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }
  .gd-period {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--gd-text);
  }
  .gd-clock {
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--gd-text);
    font-variant-numeric: tabular-nums;
  }

  .gd-final-info {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .gd-final-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gd-text3);
  }

  /* ── Situation bar ── */
  .gd-situation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 6px 20px;
    background: var(--gd-bg3);
    border-top: 1px solid var(--gd-border);
    font-size: 12px;
    font-weight: 600;
    color: var(--gd-text2);
  }
  .gd-possession { color: #e8a820; }
  .gd-down-dist  { color: var(--gd-text); }

  /* ── Countdown ── */
  .gd-countdown {
    text-align: center;
    padding: 8px 20px;
    background: var(--gd-bg3);
    border-top: 1px solid var(--gd-border);
    font-size: 12px;
    font-weight: 600;
    color: var(--gd-text3);
  }

  /* ── Tabs ── */
  .gd-tabs {
    display: flex;
    background: var(--gd-bg);
    border-top: 1px solid var(--gd-border);
    border-bottom: 1px solid var(--gd-border);
  }
  .gd-tab {
    padding: 10px 16px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gd-text5);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s;
    line-height: 1;
    margin-bottom: -1px;
  }
  .gd-tab--active {
    color: #e8a820;
    border-bottom-color: #e8a820;
  }
  .gd-tab:hover:not(.gd-tab--active) { color: var(--gd-text2); }

  /* ── Panels ── */
  .gd-panel[hidden] { display: none !important; }

  /* ── Play list ── */
  .gd-plays-list {
    display: flex;
    flex-direction: column;
    max-height: 260px;
    overflow-y: auto;
  }
  .gd-play {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: start;
    padding: 6px 14px;
    border-bottom: 1px solid var(--gd-border2);
  }
  .gd-play:last-child { border-bottom: none; }
  .gd-play--scoring {
    background: var(--gd-scoring-bg);
    border-bottom-color: var(--gd-scoring-bdr);
  }
  .gd-play-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
    min-width: 48px;
    flex-shrink: 0;
  }
  .gd-play-score-type {
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.06em;
    color: #e8a820;
    background: rgba(232,168,32,0.15);
    padding: 1px 4px;
    border-radius: 2px;
    white-space: nowrap;
  }
  .gd-play-period { font-size: 9px; color: var(--gd-text3); font-weight: 600; }
  .gd-play-clock  {
    font-size: 10px;
    color: var(--gd-text3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .gd-play-text { font-size: 12px; color: var(--gd-text2); line-height: 1.4; }
  .gd-play--scoring .gd-play-text { color: var(--gd-text); }

  /* ── Box score ── */
  .gd-bs-group { border-bottom: 1px solid var(--gd-border2); }
  .gd-bs-cat {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gd-text3);
    padding: 7px 14px 3px;
  }
  .gd-bs-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 4px 14px 5px;
    border-bottom: 1px solid var(--gd-border2);
  }
  .gd-bs-row:last-child { border-bottom: none; }
  .gd-bs-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--gd-name);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .gd-bs-stats {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .gd-bs-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
  }
  .gd-bs-val {
    font-size: 12px;
    font-weight: 700;
    color: var(--gd-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .gd-bs-lbl {
    font-size: 8px;
    font-weight: 600;
