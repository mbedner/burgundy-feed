---
import type { Article } from '../lib/types';
import StoryItem from './StoryItem.astro';
interface Props { items: Article[]; clusterMembers?: Record<string, Article[]>; }
const { items, clusterMembers = {} } = Astro.props;

// Derive set of non-primary IDs from the members map so we can suppress them
const nonPrimaryIds = new Set<string>();
for (const members of Object.values(clusterMembers)) {
  for (const m of members) nonPrimaryIds.add(m.id);
}

// Filter out non-primary cluster members (represented by the primary article)
const visibleItems = items.filter(a => !nonPrimaryIds.has(a.id));

const INITIAL_COUNT = 20;
const hiddenCount   = Math.max(0, visibleItems.length - INITIAL_COUNT);
let rank = 1;
---

<div id="filter-banner" class="filter-banner" hidden>
  <span class="filter-banner-label">Filtered by: <strong id="filter-banner-tag"></strong></span>
  <button class="filter-banner-clear" id="filter-banner-clear" type="button" aria-label="Clear filter">Clear filter</button>
</div>

<div class="stream stream-capped" id="news-stream">
  {visibleItems.map(item => (
    <StoryItem item={item} rank={rank++} clusterMembers={clusterMembers[item.id]} />
  ))}
</div>

<p id="stream-empty" class="stream-empty" hidden>
  No stories match this filter. <button class="stream-empty-clear" id="stream-empty-clear" type="button">Clear filter</button>
</p>

{hiddenCount > 0 && (
  <button class="see-more-btn" id="see-more-btn" type="button">
    See {hiddenCount} more {hiddenCount === 1 ? 'story' : 'stories'}
  </button>
)}

<style>
  /* ── Filter banner ───────────────────────────────────────────────────────── */
  .filter-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
    margin-bottom: 6px;
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
    border-radius: 5px;
    font-size: 13px;
  }
  .filter-banner[hidden] { display: none; }
  .filter-banner-label {
    flex: 1;
    color: var(--text-3);
  }
  .filter-banner-label strong {
    color: var(--accent);
    font-weight: 700;
    text-transform: capitalize;
  }
  .filter-banner-clear {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 3px;
    padding: 3px 8px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.12s;
    white-space: nowrap;
  }
  .filter-banner-clear:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  /* ── Stream ──────────────────────────────────────────────────────────────── */
  .stream { padding-bottom: 8px; }

  /* Cap: hide articles past the 20th */
  .stream-capped > :global(article:nth-child(n+21)) { display: none; }

  /* Hide rank numbers while a filter is active */
  .stream--filtered :global(.story-rank) { visibility: hidden; }

  /* ── Empty state ─────────────────────────────────────────────────────────── */
  .stream-empty {
    padding: 28px 0;
    text-align: center;
    font-size: 14px;
    color: var(--text-3);
  }
  .stream-empty[hidden] { display: none; }
  .stream-empty-clear {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    text-decoration: underline;
    padding: 0;
  }

  /* ── See More button ─────────────────────────────────────────────────────── */
  .see-more-btn {
    display: block;
    width: 100%;
    padding: 11px 0;
    margin: 4px 0 16px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-3);
    font-size: 13px;
    font-weight: 700;
    font-family: inherit;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s, background 0.12s;
  }
  .see-more-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--surface-2);
  }
  .see-more-btn[hidden] { display: none; }
</style>

<script>
  (() => {
    const stream      = document.getElementById('news-stream');
    const banner      = document.getElementById('filter-banner');
    const bannerTag   = document.getElementById('filter-banner-tag');
    const bannerClear = document.getElementById('filter-banner-clear');
    const emptyState  = document.getElementById('stream-empty');
    const emptyClear  = document.getElementById('stream-empty-clear');
    const seeMoreBtn  = document.getElementById('see-more-btn');
    if (!stream || !banner || !bannerTag || !bannerClear) return;

    let activeTag = null;
    let isCapped  = stream.classList.contains('stream-capped');

    function uncap() {
      isCapped = false;
      stream.classList.remove('stream-capped');
      if (seeMoreBtn) seeMoreBtn.hidden = true;
    }

    function applyFilters() {
      const tag = activeTag;

      // Update banner
      if (tag) {
        bannerTag.textContent = tag;
        banner.hidden = false;
        stream.classList.remove('stream-capped');
        stream.classList.add('stream--filtered');
        if (seeMoreBtn) seeMoreBtn.hidden = true;
      } else {
        banner.hidden = true;
        stream.classList.remove('stream--filtered');
        if (isCapped) {
          stream.classList.add('stream-capped');
          if (seeMoreBtn) seeMoreBtn.hidden = false;
        }
      }

      // Show/hide articles
      let visibleCount = 0;
      stream.querySelectorAll('article[data-tags]').forEach((art: Element) => {
        const el   = art as HTMLElement;
        const tags = el.dataset.tags ? el.dataset.tags.split(',') : [];
        const hide = !!tag && !tags.includes(tag);
        el.hidden = hide;
        if (!hide) visibleCount++;
      });

      // Empty state
      if (emptyState) emptyState.hidden = visibleCount > 0 || !tag;

      // Scroll into view when filtering
      if (tag) {
        const section = document.getElementById('stream');
        if (section) {
          const navH = (document.querySelector('.mast') as HTMLElement)?.offsetHeight ?? 56;
          const top  = section.getBoundingClientRect().top + window.scrollY - navH - 8;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      }
    }

    function clearFilter() {
      activeTag = null;
      applyFilters();
    }

    // Tag pill clicks (toggle: clicking same tag again clears it)
    stream.addEventListener('click', e => {
      const btn = (e.target as Element).closest('[data-filter-tag]') as HTMLElement | null;
      if (!btn) return;
      e.preventDefault();
      activeTag = activeTag === btn.dataset.filterTag ? null : btn.dataset.filterTag;
      applyFilters();
    });

    bannerClear.addEventListener('click', clearFilter);
    emptyClear?.addEventListener('click', clearFilter);
    seeMoreBtn?.addEventListener('click', uncap);
  })();
</script>
