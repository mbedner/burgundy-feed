---
import type { Article } from '../lib/types';
import StoryItem from './StoryItem.astro';
interface Props { items: Article[]; }
const { items } = Astro.props;

const INITIAL_COUNT = 20;
const hiddenCount   = Math.max(0, items.length - INITIAL_COUNT);
let rank = 1;
---

<div class="stream-controls">
  <button class="free-filter-btn" id="free-filter-btn" type="button"
          aria-pressed="false" title="Hide articles that require a subscription">
    Free articles only
  </button>
</div>

<div id="filter-banner" class="filter-banner" hidden>
  <span class="filter-banner-label">Showing: <strong id="filter-banner-tag"></strong></span>
  <button class="filter-banner-clear" id="filter-banner-clear" type="button" aria-label="Clear filter">✕ clear</button>
</div>

<div class="stream stream-capped" id="news-stream">
  {items.map(item => <StoryItem item={item} rank={rank++} />)}
</div>

{hiddenCount > 0 && (
  <button class="see-more-btn" id="see-more-btn" type="button">
    See {hiddenCount} more {hiddenCount === 1 ? 'story' : 'stories'}
  </button>
)}

<style>
  /* ── Stream controls ─────────────────────────────────────────────────────── */
  .stream-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .free-filter-btn {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-4);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 4px 10px;
    cursor: pointer;
    font-family: inherit;
    transition: color 0.12s, border-color 0.12s, background 0.12s;
  }
  .free-filter-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .free-filter-btn[aria-pressed="true"] {
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
  }

  /* ── Filter banner ───────────────────────────────────────────────────────── */
  .filter-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
    margin-bottom: 2px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 13px;
  }
  .filter-banner[hidden] { display: none; }
  .filter-banner-label {
    flex: 1;
    color: var(--text-3);
  }
  .filter-banner-label strong {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .filter-banner-clear {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-4);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 3px 8px;
    cursor: pointer;
    font-family: inherit;
    transition: color 0.12s, border-color 0.12s;
    white-space: nowrap;
  }
  .filter-banner-clear:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  /* ── Stream ──────────────────────────────────────────────────────────────── */
  .stream { padding-bottom: 8px; }

  /* Cap: hide articles past the 20th */
  .stream-capped > :global(article:nth-child(n+21)) { display: none; }

  /* ── See More button ─────────────────────────────────────────────────────── */
  .see-more-btn {
    display: block;
    width: 100%;
    padding: 11px 0;
    margin: 4px 0 16px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-3);
    font-size: 13px;
    font-weight: 700;
    font-family: inherit;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s, background 0.12s;
  }
  .see-more-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--surface-2);
  }
  .see-more-btn[hidden] { display: none; }
</style>

<script>
  (() => {
    const stream        = document.getElementById('news-stream');
    const banner        = document.getElementById('filter-banner');
    const bannerTag     = document.getElementById('filter-banner-tag');
    const bannerClear   = document.getElementById('filter-banner-clear');
    const seeMoreBtn    = document.getElementById('see-more-btn');
    const freeFilterBtn = document.getElementById('free-filter-btn');
    if (!stream || !banner || !bannerTag || !bannerClear) return;

    let activeTag  = null;
    let freeOnly   = false;
    let isCapped   = stream.classList.contains('stream-capped');

    // Restore free filter preference from localStorage
    try {
      freeOnly = localStorage.getItem('bf-free-only') === '1';
    } catch { /* localStorage unavailable */ }

    function isPaywalled(art) {
      const pw = art.dataset.paywall;
      return pw === 'subscription' || pw === 'may_require';
    }

    function uncap() {
      isCapped = false;
      stream.classList.remove('stream-capped');
      if (seeMoreBtn) seeMoreBtn.hidden = true;
    }

    function applyFilters() {
      const tag = activeTag;

      if (tag) {
        bannerTag.textContent = tag;
        banner.hidden = false;
        stream.classList.remove('stream-capped');
        if (seeMoreBtn) seeMoreBtn.hidden = true;
      } else {
        banner.hidden = true;
        if (isCapped) {
          stream.classList.add('stream-capped');
          if (seeMoreBtn) seeMoreBtn.hidden = false;
        }
      }

      stream.querySelectorAll('article[data-tags]').forEach(art => {
        const tags      = art.dataset.tags ? art.dataset.tags.split(',') : [];
        const tagHidden = !!tag && !tags.includes(tag);
        const pwHidden  = freeOnly && isPaywalled(art);
        art.hidden = tagHidden || pwHidden;
      });

      if (tag) {
        const section = document.getElementById('stream');
        if (section) {
          const navH = document.querySelector('nav, header, .nav, .masthead')?.offsetHeight ?? 56;
          const top  = section.getBoundingClientRect().top + window.scrollY - navH - 8;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      }
    }

    function setFreeOnly(val) {
      freeOnly = val;
      if (freeFilterBtn) freeFilterBtn.setAttribute('aria-pressed', val ? 'true' : 'false');
      try { localStorage.setItem('bf-free-only', val ? '1' : '0'); } catch { /* ignore */ }
      // When free filter is active, expand so all remaining articles are visible
      if (val) {
        stream.classList.remove('stream-capped');
        if (seeMoreBtn) seeMoreBtn.hidden = true;
      }
      applyFilters();
    }

    // Initialize free filter button state
    if (freeFilterBtn) {
      freeFilterBtn.setAttribute('aria-pressed', freeOnly ? 'true' : 'false');
      freeFilterBtn.addEventListener('click', () => setFreeOnly(!freeOnly));
    }

    // Apply free filter on load if previously enabled
    if (freeOnly) applyFilters();

    // Tag pill clicks
    stream.addEventListener('click', e => {
      const btn = e.target.closest('[data-filter-tag]');
      if (!btn) return;
      e.preventDefault();
      activeTag = activeTag === btn.dataset.filterTag ? null : btn.dataset.filterTag;
      applyFilters();
    });

    // Clear tag filter
    bannerClear.addEventListener('click', () => {
      activeTag = null;
      applyFilters();
    });

    // See More
    if (seeMoreBtn) {
      seeMoreBtn.addEventListener('click', uncap);
    }
  })();
</script>
