---
import type { SeasonGame } from '../config/schedule';
interface Props { schedule: SeasonGame[]; }
const { schedule } = Astro.props;

const wins   = schedule.filter(g => g.result === 'W').length;
const losses = schedule.filter(g => g.result === 'L').length;
const ties   = schedule.filter(g => g.result === 'T').length;
const played = wins + losses + ties;

function shortDate(d: string) {
  return new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---

<div class="module">
  <div class="module-hd">
    2026 Season
    {played > 0 && (
      <span class="season-rec-inline">
        {wins}-{losses}{ties > 0 ? `-${ties}` : ''}
      </span>
    )}
  </div>

  <div class="results-list">
    {schedule.map(g => {
      const isBye    = g.opponent === 'BYE';
      const isPlayed = !isBye && g.result !== undefined;
      return (
        <div class={`result-row ${isPlayed ? '' : isBye ? 'result-row--bye' : 'result-row--upcoming'}`}>
          <span class="res-wk">{g.week}</span>
          {isBye ? (
            <>
              <span class="res-ha"></span>
              <span class="res-opp res-opp--bye">BYE</span>
              <span class="res-right"></span>
              <span class="res-tag"></span>
            </>
          ) : isPlayed ? (
            <>
              <span class="res-ha">{g.home ? 'vs' : '@'}</span>
              <span class="res-opp">{g.opponent}</span>
              <span class="res-right res-score">{g.ws}–{g.os}</span>
              <span class={`res-tag res-tag--${g.result!.toLowerCase()}`}>{g.result}</span>
            </>
          ) : (
            <>
              <span class="res-ha">{g.home === null ? '' : g.home ? 'vs' : '@'}</span>
              <span class="res-opp">{g.opponent}</span>
              <span class="res-right res-upcoming">{shortDate(g.date)}</span>
              <span class="res-tv">{g.tv !== 'TBD' && g.tv !== '' ? g.tv : ''}</span>
            </>
          )}
        </div>
      );
    })}
  </div>
</div>

<style>
  .module-hd {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .season-rec-inline {
    font-size: 13px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .results-list { display: flex; flex-direction: column; }

  .result-row {
    display: grid;
    grid-template-columns: 28px 18px 1fr auto 28px;
    gap: 3px;
    align-items: center;
    padding: 5px 0;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
  }
  .result-row--bye     { opacity: 0.45; }
  .result-row--upcoming .res-opp { color: var(--text-3); }

  .res-wk  { font-size: 10px; font-weight: 700; color: var(--text-4); }
  .res-ha  { color: var(--text-3); font-size: 10px; }
  .res-opp {
    color: var(--text-2);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .res-opp--bye { color: var(--text-4); font-style: italic; }

  /* Played games */
  .res-score {
    color: var(--text-3);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .res-tag {
    font-size: 9px;
    font-weight: 800;
    text-align: center;
    border-radius: 2px;
    padding: 1px 3px;
    letter-spacing: 0.04em;
  }
  .res-tag--w { color: #22c55e; }
  .res-tag--l { color: var(--text-4); }
  .res-tag--t { color: var(--text-4); }

  /* Upcoming games */
  .res-right { text-align: right; white-space: nowrap; }
  .res-upcoming {
    font-size: 10px;
    color: var(--text-4);
    font-variant-numeric: tabular-nums;
  }
  .res-tv {
    font-size: 9px;
    color: var(--text-4);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
