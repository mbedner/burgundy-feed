---
import type { VideoItem } from '../lib/types';
interface Props { items: VideoItem[]; }
const { items } = Astro.props;
if (!items.length) return;

function rel(iso: string): string {
  const ms = Date.now() - new Date(iso).getTime();
  const m  = Math.max(0, Math.floor(ms / 60000));
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  const d = Math.floor(h / 24);
  return d === 1 ? '1 day ago' : `${d} days ago`;
}

const display = items.slice(0, 3);
const featured = display[0];
---

<section class="video-section" id="video-section">
  <h2 class="section-label">Latest Videos</h2>

  <div class="video-list">
    {display.map((v, i) => (
      <a
        href={v.url}
        target="_blank"
        rel="noopener noreferrer"
        class="video-item"
        data-video-id={i === 0 ? v.videoId : undefined}
        data-video-title={i === 0 ? v.title : undefined}
      >
        <div class="video-thumb-wrap">
          <img
            src={v.thumbnailUrl}
            alt=""
            class="video-thumb"
            loading="lazy"
            decoding="async"
            onerror="this.closest('.video-thumb-wrap').style.background='var(--surface-3)'"
          />
          <span class="play-pip" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="22" height="22" fill="none">
              <circle cx="16" cy="16" r="16" fill="rgba(0,0,0,0.55)"/>
              <polygon points="12,9 24,16 12,23" fill="#fff"/>
            </svg>
          </span>
        </div>
        <div class="video-body">
          <p class="video-title">{v.title}</p>
          <span class="video-meta">{rel(v.publishedAt)}</span>
        </div>
      </a>
    ))}
  </div>
</section>

{/* Sticky mini-player — mobile: full-width bottom bar; desktop: corner card */}
<div id="video-miniplayer" hidden aria-label="Video mini-player" role="complementary">
  {/* Mobile bar layout */}
  <div class="mini-bar">
    <div class="mini-bar-thumb">
      <iframe
        id="mini-iframe-mobile"
        src=""
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
        title="Commanders video"
        class="mini-iframe"
      ></iframe>
    </div>
    <div class="mini-bar-body">
      <p class="mini-bar-title" id="mini-title-mobile"></p>
      <a id="mini-open-mobile" href={featured.url} target="_blank" rel="noopener noreferrer"
         class="mini-bar-watch">Watch on YouTube ↗</a>
    </div>
    <button id="mini-close" class="mini-close-btn" type="button" aria-label="Close mini-player">
      <svg viewBox="0 0 14 14" width="13" height="13" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  {/* Desktop card layout */}
  <div class="mini-card">
    <div class="mini-card-header">
      <span class="mini-card-title" id="mini-title-desktop"></span>
      <div class="mini-card-controls">
        <a id="mini-open-desktop" href={featured.url} target="_blank" rel="noopener noreferrer"
           class="mini-open-btn" aria-label="Open on YouTube" title="Open on YouTube">
          <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true">
            <path d="M10 1h5v5h-1.5V3.56L7.78 9.28 6.72 8.22 12.44 2.5H10V1zM2 3h4v1.5H3.5v9h9V10H14v4H2V3z"/>
          </svg>
        </a>
        <button id="mini-close-desktop" class="mini-close-btn" type="button" aria-label="Close mini-player">
          <svg viewBox="0 0 14 14" width="12" height="12" fill="none" aria-hidden="true">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
    <div class="mini-card-player">
      <iframe
        id="mini-iframe-desktop"
        src=""
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
        title="Commanders video"
        class="mini-iframe"
      ></iframe>
    </div>
  </div>
</div>

<script>
  (() => {
    const miniplayer      = document.getElementById('video-miniplayer') as HTMLElement | null;
    const iframeMobile    = document.getElementById('mini-iframe-mobile')   as HTMLIFrameElement | null;
    const iframeDesktop   = document.getElementById('mini-iframe-desktop')  as HTMLIFrameElement | null;
    const titleMobile     = document.getElementById('mini-title-mobile');
    const titleDesktop    = document.getElementById('mini-title-desktop');
    const openMobile      = document.getElementById('mini-open-mobile')     as HTMLAnchorElement | null;
    const openDesktop     = document.getElementById('mini-open-desktop')    as HTMLAnchorElement | null;
    const closeBtn        = document.getElementById('mini-close');
    const closeBtnDesktop = document.getElementById('mini-close-desktop');
    if (!miniplayer || !iframeMobile || !iframeDesktop) return;

    const firstCard  = document.querySelector('[data-video-id]') as HTMLElement | null;
    const videoId    = firstCard?.dataset.videoId   ?? '';
    const videoTitle = firstCard?.dataset.videoTitle ?? '';
    if (!videoId) return;

    let iframeLoaded  = false;
    let miniDismissed = false;

    try {
      if (sessionStorage.getItem('bf-mini-dismissed') === videoId) miniDismissed = true;
    } catch {}

    function showMini() {
      if (miniDismissed) return;
      if (!iframeLoaded) {
        iframeLoaded = true;
        const params = new URLSearchParams({
          autoplay: '1', mute: '1', playsinline: '1', rel: '0', modestbranding: '1',
        });
        const src = `https://www.youtube-nocookie.com/embed/${videoId}?${params}`;
        iframeMobile.src  = src;
        iframeDesktop.src = src;
        const ytUrl = `https://www.youtube.com/watch?v=${videoId}`;
        if (titleMobile)  titleMobile.textContent  = videoTitle;
        if (titleDesktop) titleDesktop.textContent = videoTitle;
        if (openMobile)   openMobile.href   = ytUrl;
        if (openDesktop)  openDesktop.href  = ytUrl;
      }
      miniplayer.hidden = false;
      requestAnimationFrame(() => miniplayer.classList.add('mini--visible'));
    }

    function dismiss() {
      miniDismissed = true;
      try { sessionStorage.setItem('bf-mini-dismissed', videoId); } catch {}
      miniplayer.classList.remove('mini--visible');
      iframeMobile.src  = '';
      iframeDesktop.src = '';
      setTimeout(() => { miniplayer.hidden = true; }, 280);
    }

    closeBtn?.addEventListener('click', dismiss);
    closeBtnDesktop?.addEventListener('click', dismiss);

    showMini();
  })();
</script>

<style>
  .video-section {
    padding-top: 4px;
    padding-bottom: 0px;
  }

  .section-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 14px 0 12px;
    border-top: 1px solid var(--border);
    margin: 0;
    display: block;
  }

  /* ── Card list ── */
  .video-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .video-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }
  .video-item:last-child { border-bottom: none; }
  .video-item:hover .video-title { color: var(--accent); }

  .video-thumb-wrap {
    position: relative;
    width: 160px;
    flex-shrink: 0;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface-2);
  }
  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.2s ease;
  }
  .video-item:hover .video-thumb { transform: scale(1.04); }

  .play-pip {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .video-item:hover .play-pip { opacity: 1; }

  .video-body { flex: 1; min-width: 0; }
  .video-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    margin: 0 0 4px;
    transition: color 0.12s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .video-meta { font-size: 11px; color: var(--text-4); }

  /* ── Shared mini-player shell ── */
  #video-miniplayer {
    position: fixed;
    z-index: 500;
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  #video-miniplayer[hidden] { display: none; }
  #video-miniplayer.mini--visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Mobile: full-width bottom bar ── */
  .mini-card { display: none; }

  .mini-bar {
    display: flex;
    align-items: stretch;
    gap: 0;
    background: #111;
    border-top: 1px solid #333;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.4);
  }

  #video-miniplayer {
    bottom: 0;
    left: 0;
    right: 0;
    transform: translateY(100%);
  }
  #video-miniplayer.mini--visible { transform: translateY(0); }

  .mini-bar-thumb {
    position: relative;
    width: 160px;
    flex-shrink: 0;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
    align-self: stretch;
  }
  .mini-bar-thumb .mini-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .mini-bar-body {
    flex: 1;
    min-width: 0;
    padding: 10px 4px 10px 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
  }
  .mini-bar-title {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }
  .mini-bar-watch {
    font-size: 11px;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .mini-bar-watch:hover { color: var(--accent); }

  .mini-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    flex-shrink: 0;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.5);
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    transition: color 0.12s;
    align-self: stretch;
  }
  .mini-close-btn:hover { color: #fff; }

  /* ── Desktop: corner card ── */
  @media (min-width: 768px) {
    .mini-bar  { display: none; }
    .mini-card { display: block; }

    #video-miniplayer {
      bottom: 24px;
      right: 24px;
      left: auto;
      width: 380px;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 8px 40px rgba(0,0,0,0.4), 0 2px 8px rgba(0,0,0,0.2);
      border: 1px solid var(--border-strong);
      background: var(--surface);
      transform: translateY(16px);
    }
    #video-miniplayer.mini--visible { transform: translateY(0); }

    .mini-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 8px 8px 8px 12px;
      background: var(--surface-2);
      border-bottom: 1px solid var(--border);
    }
    .mini-card-title {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-2);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
      min-width: 0;
    }
    .mini-card-controls {
      display: flex;
      align-items: center;
      gap: 2px;
      flex-shrink: 0;
    }
    .mini-open-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      color: var(--text-4);
      border-radius: 3px;
      text-decoration: none;
      transition: color 0.12s, background 0.12s;
    }
    .mini-open-btn:hover { color: var(--accent); background: var(--surface-3); }
    .mini-card .mini-close-btn {
      width: 26px;
      height: 26px;
      border-radius: 3px;
      color: var(--text-4);
      align-self: auto;
    }
    .mini-card .mini-close-btn:hover { color: var(--text); background: var(--surface-3); }

    .mini-card-player {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
    }
    .mini-card-player .mini-iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }
  }

  /* ── Compact mode ── */
  :global(html[data-display="compact"]) .video-thumb-wrap { width: 100px; }
  :global(html[data-display="compact"]) .video-title { font-size: 13px; }
</style>
