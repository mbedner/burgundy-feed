---
import type { VideoItem } from '../lib/types';
interface Props { items: VideoItem[]; }
const { items } = Astro.props;
if (!items.length) return;

function rel(iso: string): string {
  const ms = Date.now() - new Date(iso).getTime();
  const m  = Math.max(0, Math.floor(ms / 60000));
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  const d = Math.floor(h / 24);
  return d === 1 ? '1 day ago' : `${d} days ago`;
}

const display = items.slice(0, 3);
const featured = display[0];
---

<section class="video-section" id="video-section">
  <h2 class="section-label">Latest Videos</h2>

  <div class="video-list">
    {display.map((v, i) => (
      <a
        href={v.url}
        target="_blank"
        rel="noopener noreferrer"
        class="video-item"
        data-video-id={i === 0 ? v.videoId : undefined}
        data-video-title={i === 0 ? v.title : undefined}
      >
        <div class="video-thumb-wrap">
          <img
            src={v.thumbnailUrl}
            alt=""
            class="video-thumb"
            loading="lazy"
            decoding="async"
            onerror="this.closest('.video-thumb-wrap').style.background='var(--surface-3)'"
          />
          <span class="play-pip" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="20" height="20" fill="none">
              <circle cx="16" cy="16" r="16" fill="rgba(0,0,0,0.55)"/>
              <polygon points="12,9 24,16 12,23" fill="#fff"/>
            </svg>
          </span>
        </div>
        <div class="video-body">
          <p class="video-title">{v.title}</p>
          <span class="video-meta">{rel(v.publishedAt)}</span>
        </div>
      </a>
    ))}
  </div>

</section>

{/* Mini-player — injected by JS when sentinel exits viewport */}
<div id="video-miniplayer" hidden aria-label="Video mini-player" role="complementary">
  <div class="mini-header">
    <span class="mini-title" id="mini-title"></span>
    <div class="mini-controls">
      <a id="mini-open" href={featured.url} target="_blank" rel="noopener noreferrer"
         class="mini-open-btn" aria-label="Open on YouTube" title="Open on YouTube">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M10 1h5v5h-1.5V3.56L7.78 9.28 6.72 8.22 12.44 2.5H10V1zM2 3h4v1.5H3.5v9h9V10H14v4H2V3z"/>
        </svg>
      </a>
      <button id="mini-close" class="mini-close-btn" type="button" aria-label="Close mini-player">
        <svg viewBox="0 0 14 14" width="12" height="12" fill="currentColor" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
  <div class="mini-player-wrap">
    <iframe
      id="mini-iframe"
      src=""
      allow="autoplay; encrypted-media; picture-in-picture"
      allowfullscreen
      title="Commanders video"
      class="mini-iframe"
    ></iframe>
  </div>
</div>

<script>
  (() => {
    const sentinel   = document.getElementById('video-sentinel');
    const miniplayer = document.getElementById('video-miniplayer') as HTMLElement | null;
    const miniIframe = document.getElementById('mini-iframe')      as HTMLIFrameElement | null;
    const miniTitle  = document.getElementById('mini-title');
    const miniClose  = document.getElementById('mini-close');
    const miniOpen   = document.getElementById('mini-open')        as HTMLAnchorElement | null;
    if (!sentinel || !miniplayer || !miniIframe) return;

    // Grab video ID + title from the first card
    const firstCard = document.querySelector('[data-video-id]') as HTMLElement | null;
    const videoId   = firstCard?.dataset.videoId   ?? '';
    const videoTitle= firstCard?.dataset.videoTitle ?? '';
    if (!videoId) return;

    let miniLoaded   = false;
    let miniDismissed= false;

    try {
      if (sessionStorage.getItem('bf-mini-dismissed') === videoId) miniDismissed = true;
    } catch {}

    function showMini() {
      if (miniDismissed || miniLoaded) return;
      miniLoaded = true;

      const params = new URLSearchParams({
        autoplay: '1', mute: '1', playsinline: '1', rel: '0', modestbranding: '1',
      });
      miniIframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?${params}`;
      if (miniTitle)  miniTitle.textContent = videoTitle;
      if (miniOpen)   miniOpen.href = `https://www.youtube.com/watch?v=${videoId}`;

      miniplayer.hidden = false;
      // Slight delay so the hidden→visible transition fires
      requestAnimationFrame(() => miniplayer.classList.add('mini--visible'));
    }

    function hideMini() {
      miniplayer.classList.remove('mini--visible');
      setTimeout(() => { miniplayer.hidden = true; }, 280);
    }

    miniClose?.addEventListener('click', () => {
      miniDismissed = true;
      try { sessionStorage.setItem('bf-mini-dismissed', videoId); } catch {}
      hideMini();
    });

    // Pattern: user scrolls DOWN to the video section (hasSeen=true),
    // then scrolls back UP — section leaves the bottom of the viewport,
    // mini-player pops up so video follows them while they read.
    const section = document.getElementById('video-section');
    if ('IntersectionObserver' in window && section) {
      let hasSeen = false;
      const obs = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          hasSeen = true;
          // Back in view — hide mini
          if (miniLoaded && !miniDismissed) hideMini();
        } else if (!entry.isIntersecting && hasSeen && entry.boundingClientRect.top > 0) {
          // Section is below the fold (user scrolled back up past it) — show mini
          showMini();
        }
      }, { threshold: 0 });
      obs.observe(section);
    }
  })();
</script>

<style>
  .video-section {
    padding-top: 4px;
    padding-bottom: 32px;
  }

  .section-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 14px 0 12px;
    border-top: 1px solid var(--border);
    margin-top: 4px;
    display: block;
  }

  /* ── Card list ── */
  .video-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .video-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }
  .video-item:last-child { border-bottom: none; }
  .video-item:hover .video-title { color: var(--accent); }

  .video-thumb-wrap {
    position: relative;
    width: 120px;
    flex-shrink: 0;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface-2);
  }
  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12.5%;
    display: block;
    transition: transform 0.2s ease;
  }
  .video-item:hover .video-thumb { transform: scale(1.04); }

  .play-pip {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .video-item:hover .play-pip { opacity: 1; }

  .video-body { flex: 1; min-width: 0; }
  .video-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    margin: 0 0 4px;
    transition: color 0.12s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .video-meta {
    font-size: 11px;
    color: var(--text-4);
  }

  /* ── Mini-player ── */
  #video-miniplayer {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 280px;
    z-index: 500;
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 8px 32px rgba(0,0,0,0.35), 0 2px 8px rgba(0,0,0,0.2);
    border: 1px solid var(--border-strong);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  #video-miniplayer[hidden] { display: none; }
  #video-miniplayer.mini--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mini-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 8px 7px 10px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .mini-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    min-width: 0;
  }
  .mini-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }
  .mini-open-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--text-4);
    border-radius: 3px;
    text-decoration: none;
    transition: color 0.12s, background 0.12s;
  }
  .mini-open-btn:hover { color: var(--accent); background: var(--surface-3); }
  .mini-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: transparent;
    border: none;
    border-radius: 3px;
    color: var(--text-4);
    cursor: pointer;
    font-family: inherit;
    padding: 0;
    transition: color 0.12s, background 0.12s;
  }
  .mini-close-btn:hover { color: var(--text); background: var(--surface-3); }

  .mini-player-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .mini-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* ── Compact mode ── */
  :global(html[data-display="compact"]) .video-thumb-wrap { width: 80px; }
  :global(html[data-display="compact"]) .video-title { font-size: 13px; }
</style>
