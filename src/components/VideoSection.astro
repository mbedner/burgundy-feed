---
import type { VideoItem } from '../lib/types';
interface Props { items: VideoItem[]; }
const { items } = Astro.props;
if (!items.length) return;

function rel(iso: string): string {
  const ms = Date.now() - new Date(iso).getTime();
  const m  = Math.max(0, Math.floor(ms / 60000));
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  const d = Math.floor(h / 24);
  return d === 1 ? '1 day ago' : `${d} days ago`;
}

const display = items.slice(0, 3);
---

<section class="video-section">
  <h2 class="section-label">Latest Videos</h2>
  <div class="video-grid">
    {display.map(v => (
      <a
        href={v.url}
        target="_blank"
        rel="noopener noreferrer"
        class="video-card"
        aria-label={v.title}
      >
        <div class="video-thumb-wrap">
          <img
            src={v.thumbnailUrl}
            alt=""
            class="video-thumb"
            loading="lazy"
            decoding="async"
            onerror="this.closest('.video-thumb-wrap').classList.add('thumb-error')"
          />
          <div class="play-icon" aria-hidden="true">
            <svg viewBox="0 0 36 36" width="36" height="36" fill="none">
              <circle cx="18" cy="18" r="18" fill="rgba(0,0,0,0.55)"/>
              <polygon points="14,11 28,18 14,25" fill="#fff"/>
            </svg>
          </div>
        </div>
        <p class="video-title">{v.title}</p>
        <span class="video-meta">{rel(v.publishedAt)}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .video-section {
    padding-top: 4px;
    padding-bottom: 32px;
  }

  .section-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 14px 0 12px;
    border-top: 1px solid var(--border);
    margin-top: 4px;
    display: block;
  }

  .video-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 480px) {
    .video-grid { grid-template-columns: repeat(3, 1fr); gap: 14px; }
  }

  .video-card {
    display: block;
    text-decoration: none;
  }
  .video-card:hover .video-title { color: var(--accent); }

  .video-thumb-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 5px;
    overflow: hidden;
    background: var(--surface-2);
    margin-bottom: 8px;
  }
  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }
  .video-card:hover .video-thumb { transform: scale(1.03); }

  /* YouTube thumbnails have black bars — crop them out */
  .video-thumb {
    object-position: center 12.5%;
  }

  .thumb-error .video-thumb { display: none; }

  .play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .video-card:hover .play-icon { opacity: 1; }

  .video-title {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    margin: 0 0 3px;
    transition: color 0.12s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .video-meta {
    font-size: 11px;
    color: var(--text-4);
  }

  /* Compact mode: hide thumbnails, show as tight list */
  :global(html[data-display="compact"]) .video-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  :global(html[data-display="compact"]) .video-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  :global(html[data-display="compact"]) .video-card:last-child { border-bottom: none; }
  :global(html[data-display="compact"]) .video-thumb-wrap {
    width: 80px;
    flex-shrink: 0;
    aspect-ratio: 16 / 9;
    margin-bottom: 0;
    border-radius: 3px;
  }
  :global(html[data-display="compact"]) .video-title {
    font-size: 13px;
    -webkit-line-clamp: 2;
  }
</style>
