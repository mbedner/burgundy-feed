---
import type { VideoItem } from '../lib/types';
interface Props { items: VideoItem[]; }
const { items } = Astro.props;
if (!items.length) return;

function rel(iso: string): string {
  const ms = Date.now() - new Date(iso).getTime();
  const m  = Math.max(0, Math.floor(ms / 60000));
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  const d = Math.floor(h / 24);
  return d === 1 ? '1 day ago' : `${d} days ago`;
}

const [featured, ...rest] = items.slice(0, 4);
---

<section class="video-section">
  <h2 class="section-label">Latest Videos</h2>

  {/* ── Featured video — autoplays muted on scroll ── */}
  <div class="video-featured" id="video-featured">
    <div class="video-player-wrap" data-video-id={featured.videoId}>
      {/* Thumbnail shown until video enters viewport */}
      <div class="video-thumb-layer">
        <img
          src={featured.thumbnailUrl}
          alt=""
          class="video-featured-thumb"
          loading="lazy"
          decoding="async"
        />
        <button class="video-play-btn" aria-label="Play video" type="button">
          <svg viewBox="0 0 64 64" width="48" height="48" fill="none" aria-hidden="true">
            <circle cx="32" cy="32" r="32" fill="rgba(0,0,0,0.6)"/>
            <polygon points="25,18 50,32 25,46" fill="#fff"/>
          </svg>
        </button>
      </div>
      {/* iframe injected here by JS when visible */}
    </div>
    <p class="video-featured-title">{featured.title}</p>
    <span class="video-meta">{rel(featured.publishedAt)}</span>
  </div>

  {/* ── Additional videos as compact thumbnails ── */}
  {rest.length > 0 && (
    <div class="video-more">
      {rest.map(v => (
        <a href={v.url} target="_blank" rel="noopener noreferrer" class="video-more-item">
          <div class="video-more-thumb-wrap">
            <img
              src={v.thumbnailUrl}
              alt=""
              class="video-more-thumb"
              loading="lazy"
              decoding="async"
            />
            <span class="video-more-play" aria-hidden="true">▶</span>
          </div>
          <div class="video-more-body">
            <p class="video-more-title">{v.title}</p>
            <span class="video-meta">{rel(v.publishedAt)}</span>
          </div>
        </a>
      ))}
    </div>
  )}
</section>

<script>
  (() => {
    const wrap = document.querySelector('.video-player-wrap') as HTMLElement | null;
    if (!wrap) return;

    const videoId = wrap.dataset.videoId;
    if (!videoId) return;

    let loaded = false;

    function loadIframe(autoplay: boolean) {
      if (loaded) return;
      loaded = true;

      const params = new URLSearchParams({
        autoplay:    autoplay ? '1' : '0',
        mute:        '1',
        playsinline: '1',
        rel:         '0',
        modestbranding: '1',
      });

      const iframe = document.createElement('iframe');
      iframe.src    = `https://www.youtube-nocookie.com/embed/${videoId}?${params}`;
      iframe.allow  = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title  = 'Commanders video';
      iframe.className = 'video-iframe';

      wrap.appendChild(iframe);

      // Fade out thumbnail layer
      const thumbLayer = wrap.querySelector('.video-thumb-layer') as HTMLElement | null;
      if (thumbLayer) {
        thumbLayer.style.opacity = '0';
        thumbLayer.style.pointerEvents = 'none';
      }
    }

    // Autoplay muted when scrolled into view
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) {
          loadIframe(true);
          obs.disconnect();
        }
      }, { threshold: 0.35 });
      obs.observe(wrap);
    }

    // Manual play button — load without waiting for intersection
    const playBtn = wrap.querySelector('.video-play-btn');
    if (playBtn) {
      playBtn.addEventListener('click', () => loadIframe(false));
    }
  })();
</script>

<style>
  .video-section {
    padding-top: 4px;
    padding-bottom: 32px;
  }

  .section-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 14px 0 12px;
    border-top: 1px solid var(--border);
    margin-top: 4px;
    display: block;
  }

  /* ── Featured player ── */
  .video-featured { margin-bottom: 16px; }

  .video-player-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 10px;
  }

  .video-thumb-layer {
    position: absolute;
    inset: 0;
    transition: opacity 0.3s ease;
  }

  .video-featured-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* crop YouTube black bars */
    object-position: center 12.5%;
    display: block;
  }

  .video-play-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: transform 0.15s;
  }
  .video-play-btn:hover { transform: scale(1.08); }

  :global(.video-iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 6px;
  }

  .video-featured-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    margin: 0 0 4px;
  }

  .video-meta {
    font-size: 11px;
    color: var(--text-4);
    display: block;
  }

  /* ── More videos ── */
  .video-more {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .video-more-item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 10px 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }
  .video-more-item:hover .video-more-title { color: var(--accent); }

  .video-more-thumb-wrap {
    position: relative;
    width: 100px;
    flex-shrink: 0;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface-2);
  }
  .video-more-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12.5%;
    display: block;
    transition: transform 0.2s ease;
  }
  .video-more-item:hover .video-more-thumb { transform: scale(1.04); }

  .video-more-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: rgba(255,255,255,0.85);
    background: rgba(0,0,0,0.35);
    opacity: 0;
    transition: opacity 0.15s;
  }
  .video-more-item:hover .video-more-play { opacity: 1; }

  .video-more-body { flex: 1; min-width: 0; }

  .video-more-title {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    margin: 0 0 3px;
    transition: color 0.12s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Compact mode ── */
  :global(html[data-display="compact"]) .video-player-wrap { aspect-ratio: unset; height: 0; overflow: hidden; pointer-events: none; }
  :global(html[data-display="compact"]) .video-featured-title { font-size: 14px; }
  :global(html[data-display="compact"]) .video-more-thumb-wrap { width: 72px; }
</style>
