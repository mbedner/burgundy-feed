---
// Scores strip — fully client-side (ESPN blocks Cloudflare Workers egress)
---

<div class="ss-shell" id="ssShell" hidden>
  <div class="ss-nav" id="ssNav">
    <button class="ss-week-btn" id="ssWeekBtn" aria-haspopup="listbox" aria-expanded="false">
      <span id="ssWeekLabel">Week 1</span>
      <svg class="ss-chevron" width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
        <path d="M1 2.5L4 5.5L7 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="ss-week-panel" id="ssWeekPanel" role="listbox" aria-label="Select week" hidden></div>
  </div>
  <div class="ss-track" id="ssTrack"></div>
</div>

<script>
(async () => {
  const BASE   = 'https://site.api.espn.com/apis/site/v2/sports/football/nfl';
  const WAS_ID = '28';
  const MAX_WEEK = 18;

  let currentWeek = 1;
  let currentYear = 2026;
  let currentSeasonType = 2; // 2 = regular season

  function logoImg(url: string, alt: string): string {
    return url
      ? `<img class="ss-logo" src="${url}" alt="${alt}" loading="lazy" width="20" height="20" />`
      : `<span class="ss-logo ss-logo--blank"></span>`;
  }

  function buildCards(events: any[]): { html: string; wasIdx: number } {
    let wasIdx = -1;
    const html = events.map((ev: any, i: number) => {
      const comp = ev?.competitions?.[0];
      if (!comp) return '';

      const teams: any[] = comp.competitors ?? [];
      const away = teams.find((t: any) => t.homeAway === 'away');
      const home = teams.find((t: any) => t.homeAway === 'home');
      if (!away || !home) return '';

      const isWas = away.id === WAS_ID || home.id === WAS_ID;
      if (isWas) wasIdx = i;

      const st    = comp.status;
      const state = st?.type?.state ?? 'pre';
      const desc  = (st?.type?.description ?? '').toLowerCase();
      const isPre  = state === 'pre';
      const isPost = state === 'post';
      const isHalf = !isPre && !isPost && desc.includes('halftime');
      const isLive = !isPre && !isPost;

      const awayScore = parseInt(away.score ?? '0') || 0;
      const homeScore = parseInt(home.score ?? '0') || 0;
      const awayWon   = isPost && !!away.winner;
      const homeWon   = isPost && !!home.winner;

      const awayLogo = away.team?.logo ?? '';
      const homeLogo = home.team?.logo ?? '';
      const awayAbbr = away.team?.abbreviation ?? '???';
      const homeAbbr = home.team?.abbreviation ?? '???';

      let statusHtml = '';
      if (isPre) {
        const dt = new Date(comp.date || ev.date);
        const t  = dt.toLocaleTimeString('en-US', {
          hour: 'numeric', minute: '2-digit', hour12: true,
          timeZone: 'America/New_York',
        });
        const net = comp.broadcasts?.[0]?.names?.[0] ?? '';
        statusHtml = `<span class="ss-st-time">${t}</span>${net ? `<span class="ss-st-net">${net}</span>` : ''}`;
      } else if (isHalf) {
        statusHtml = `<span class="ss-st-live"><span class="ss-dot"></span>HALF</span>`;
      } else if (isLive) {
        const period = st?.period ?? 1;
        const clock  = st?.displayClock ?? '';
        const ql     = period > 4 ? 'OT' : `Q${period}`;
        statusHtml = `<span class="ss-st-live"><span class="ss-dot"></span>${ql} ${clock}</span>`;
      } else {
        statusHtml = `<span class="ss-st-final">Final</span>`;
      }

      const scoreOrDash = (s: number) => isPre ? '' : String(s);

      return `<a class="ss-card${isWas ? ' ss-card--was' : ''}" href="${ev.links?.[0]?.href ?? '#'}" target="_blank" rel="noopener noreferrer">
        <div class="ss-team${isPost && !awayWon ? ' ss-team--dim' : ''}">
          ${logoImg(awayLogo, awayAbbr)}
          <span class="ss-abbr">${awayAbbr}</span>
          <span class="ss-score${awayWon ? ' ss-score--win' : ''}">${scoreOrDash(awayScore)}</span>
          ${awayWon ? '<span class="ss-caret" aria-hidden="true">&#9668;</span>' : '<span class="ss-caret-gap"></span>'}
        </div>
        <div class="ss-team${isPost && !homeWon ? ' ss-team--dim' : ''}">
          ${logoImg(homeLogo, homeAbbr)}
          <span class="ss-abbr">${homeAbbr}</span>
          <span class="ss-score${homeWon ? ' ss-score--win' : ''}">${scoreOrDash(homeScore)}</span>
          ${homeWon ? '<span class="ss-caret" aria-hidden="true">&#9668;</span>' : '<span class="ss-caret-gap"></span>'}
        </div>
        <div class="ss-status${isLive || isHalf ? ' ss-status--live' : ''}">${statusHtml}</div>
      </a>`;
    }).filter(Boolean).join('');

    return { html, wasIdx };
  }

  async function loadWeek(week: number, year: number, seasonType: number, scrollToWas = false) {
    const track  = document.getElementById('ssTrack')      as HTMLElement | null;
    const select = document.getElementById('ssWeekSelect') as HTMLSelectElement | null;
    if (!track) return;

    track.style.opacity = '0.4';

    try {
      const url = `${BASE}/scoreboard?seasontype=${seasonType}&week=${week}&year=${year}`;
      const res = await fetch(url);
      if (!res.ok) { track.style.opacity = '1'; return; }
      const data = await res.json() as any;

      const events: any[] = data?.events ?? [];
      if (!events.length) { track.style.opacity = '1'; return; }

      const { html, wasIdx } = buildCards(events);
      track.innerHTML = html;
      track.style.opacity = '1';

      const lbl = document.getElementById('ssWeekLabel');
      if (lbl) lbl.textContent = `Week ${week}`;
      const panel = document.getElementById('ssWeekPanel');
      if (panel) panel.querySelectorAll('.ss-week-item').forEach(el => {
        const match = el.getAttribute('data-week') === String(week);
        el.classList.toggle('ss-week-item--active', match);
        el.setAttribute('aria-selected', match ? 'true' : 'false');
      });

      if (scrollToWas && wasIdx >= 0) {
        const wasCard = track.children[wasIdx] as HTMLElement | null;
        if (wasCard) {
          requestAnimationFrame(() => {
            const scrollLeft = wasCard.offsetLeft - track.clientWidth / 2 + wasCard.offsetWidth / 2;
            track.scrollLeft = Math.max(0, scrollLeft);
          });
        }
      } else {
        track.scrollLeft = 0;
      }
    } catch {
      track.style.opacity = '1';
    }
  }

  // Initial load — use current week from API (no params = current week)
  try {
    const res = await fetch(`${BASE}/scoreboard`);
    if (!res.ok) return;
    const data = await res.json() as any;

    const events: any[] = data?.events ?? [];
    if (!events.length) return;

    currentWeek       = data?.week?.number ?? 1;
    currentYear       = data?.season?.year ?? 2026;
    currentSeasonType = data?.season?.type ?? 2;

    const shell     = document.getElementById('ssShell');
    const weekBtn   = document.getElementById('ssWeekBtn')   as HTMLButtonElement | null;
    const weekLabel = document.getElementById('ssWeekLabel') as HTMLElement | null;
    const weekPanel = document.getElementById('ssWeekPanel') as HTMLElement | null;
    if (shell) shell.hidden = false;

    const { html, wasIdx } = buildCards(events);
    const track = document.getElementById('ssTrack') as HTMLElement | null;
    if (!track || !weekBtn || !weekLabel || !weekPanel) return;

    // Populate custom dropdown panel
    for (let w = 1; w <= MAX_WEEK; w++) {
      const item = document.createElement('div');
      item.className = 'ss-week-item' + (w === currentWeek ? ' ss-week-item--active' : '');
      item.setAttribute('role', 'option');
      item.setAttribute('aria-selected', w === currentWeek ? 'true' : 'false');
      item.setAttribute('data-week', String(w));
      item.textContent = `Week ${w}`;
      weekPanel.appendChild(item);
    }

    track.innerHTML = html;

    if (wasIdx >= 0) {
      const wasCard = track.children[wasIdx] as HTMLElement | null;
      if (wasCard) {
        requestAnimationFrame(() => {
          const scrollLeft = wasCard.offsetLeft - track.clientWidth / 2 + wasCard.offsetWidth / 2;
          track.scrollLeft = Math.max(0, scrollLeft);
        });
      }
    }

    // Toggle panel open/close
    function closePanel() {
      weekPanel.hidden = true;
      weekBtn!.setAttribute('aria-expanded', 'false');
      weekBtn!.classList.remove('ss-week-btn--open');
    }
    function openPanel() {
      // Position fixed relative to button so it escapes overflow:hidden on .ss-shell
      const rect = weekBtn!.getBoundingClientRect();
      weekPanel.style.top  = `${rect.bottom + 4}px`;
      weekPanel.style.left = `${rect.left}px`;
      weekPanel.hidden = false;
      weekBtn!.setAttribute('aria-expanded', 'true');
      weekBtn!.classList.add('ss-week-btn--open');
      const active = weekPanel.querySelector('.ss-week-item--active') as HTMLElement | null;
      if (active) active.scrollIntoView({ block: 'nearest' });
    }

    weekBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      weekPanel.hidden ? openPanel() : closePanel();
    });

    weekPanel.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest('[data-week]') as HTMLElement | null;
      if (!item) return;
      const w = parseInt(item.getAttribute('data-week') ?? '');
      if (!w) return;
      currentWeek = w;
      weekLabel.textContent = `Week ${w}`;
      weekPanel.querySelectorAll('.ss-week-item').forEach(el => {
        el.classList.toggle('ss-week-item--active', el === item);
        el.setAttribute('aria-selected', el === item ? 'true' : 'false');
      });
      closePanel();
      loadWeek(currentWeek, currentYear, currentSeasonType, false);
    });

    // Close on outside click
    document.addEventListener('click', closePanel);

  } catch { /* silent */ }
})();
</script>

<style is:global>
  /* ── Strip shell ── */
  .ss-shell {
    display: flex;
    align-items: stretch;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    overflow-y: hidden;
  }

  /* ── Week nav sidebar ── */
  .ss-nav {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid var(--border);
    padding: 0 10px;
    position: relative;
  }

  .ss-week-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px 2px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .ss-chevron {
    color: var(--accent);
    flex-shrink: 0;
    transition: transform 0.15s;
  }
  .ss-week-btn--open .ss-chevron { transform: rotate(180deg); }

  .ss-week-panel {
    position: fixed;
    z-index: 9999;
    background: var(--surface);
    border: 1px solid var(--border-strong, var(--border));
    border-radius: 6px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.22);
    overflow-y: scroll;
    -webkit-overflow-scrolling: touch;
    max-height: 260px;
    width: 130px;
    padding: 4px 0;
  }

  .ss-week-item {
    padding: 9px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.1s, color 0.1s;
  }
  .ss-week-item:hover,
  .ss-week-item:active { background: var(--bg); }
  .ss-week-item--active {
    color: var(--accent);
    font-weight: 800;
  }

  /* ── Scrollable track ── */
  .ss-track {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex: 1;
    transition: opacity 0.15s;
  }
  .ss-track::-webkit-scrollbar { display: none; }

  /* ── Game card ── */
  .ss-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 7px 10px 6px;
    border-right: 1px solid var(--border);
    text-decoration: none;
    min-width: 0;
    flex-shrink: 0;
    transition: background 0.1s;
    position: relative;
  }
  .ss-card:hover { background: var(--surface-2); }

  .ss-card--was { background: var(--surface-2); }
  .ss-card--was::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent);
  }

  /* ── Team row ── */
  .ss-team {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .ss-team--dim { opacity: 0.4; }

  .ss-logo {
    width: 20px;
    height: 20px;
    object-fit: contain;
    flex-shrink: 0;
    display: block;
  }
  .ss-logo--blank { width: 20px; height: 20px; flex-shrink: 0; }

  .ss-abbr {
    font-size: 11px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
    white-space: nowrap;
    width: 28px;
  }

  .ss-score {
    font-size: 13px;
    font-weight: 800;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    width: 20px;
    text-align: right;
    flex-shrink: 0;
  }

  .ss-caret {
    font-size: 8px;
    color: var(--accent);
    flex-shrink: 0;
    width: 10px;
  }
  .ss-caret-gap { width: 10px; flex-shrink: 0; }

  /* ── Status row ── */
  .ss-status {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 3px;
    padding-top: 4px;
    border-top: 1px solid var(--border);
  }
  .ss-st-final,
  .ss-st-time,
  .ss-st-net {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-4);
    white-space: nowrap;
  }
  .ss-st-live {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-2);
    white-space: nowrap;
  }
  .ss-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ef4444;
    flex-shrink: 0;
    animation: ss-blink 1.2s ease-in-out infinite;
  }
  @keyframes ss-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }
</style>
