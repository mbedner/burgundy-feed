---
// ─── NFC East Division Standings ──────────────────────────────────────────────
interface StandingsEntry {
  name:       string;   // team display name
  abbr:       string;   // team abbreviation
  wins:       number;
  losses:     number;
  ties:       number;
  pct:        string;   // e.g. ".647"
  isCommanders: boolean;
}
interface Props { entries: StandingsEntry[]; }
const { entries } = Astro.props;
if (!entries.length) return;
---

<div class="module">
  <div class="module-hd">NFC East</div>
  <div class="std-col-hdr">
    <span></span>
    <span class="std-lbl">W</span>
    <span class="std-lbl">L</span>
    <span class="std-lbl std-lbl--r">PCT</span>
  </div>
  {entries.map(e => (
    <div class={`std-row${e.isCommanders ? ' std-row--us' : ''}`}>
      <span class="std-abbr">{e.abbr}</span>
      <span class="std-num">{e.wins}</span>
      <span class="std-num">{e.losses}</span>
      <span class="std-pct">{e.pct}</span>
    </div>
  ))}
</div>

<style>
  .module-hd {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 12px;
  }

  .std-col-hdr {
    display: grid;
    grid-template-columns: 1fr 22px 22px 36px;
    gap: 4px;
    align-items: center;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--border);
  }
  .std-lbl {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-4);
    text-align: center;
  }
  .std-lbl--r { text-align: right; }

  .std-row {
    display: grid;
    grid-template-columns: 1fr 22px 22px 36px;
    gap: 4px;
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
  }
  .std-row:last-child { border-bottom: none; }

  .std-abbr { font-weight: 600; color: var(--text-2); }
  .std-num  { text-align: center; color: var(--text-2); font-variant-numeric: tabular-nums; }
  .std-pct  { text-align: right; font-size: 10px; color: var(--text-4); font-variant-numeric: tabular-nums; }

  .std-row--us .std-abbr { font-weight: 800; color: var(--accent); }
</style>
