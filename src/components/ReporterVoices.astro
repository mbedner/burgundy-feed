---
import type { REPORTER_CONFIG } from '../config/reporters';
interface Props { config: typeof REPORTER_CONFIG; }
const { config } = Astro.props;

const hasFeed = !!config.feedProvider;
---

<div class="voices">
  <div class="voices-header">
    <h2 class="section-label">Reporter Voices</h2>
    {!hasFeed && (
      <span class="voices-mode-badge" title="No live feed connected — these are links to reporter profiles">Directory</span>
    )}
  </div>
  <p class="voices-sub">
    {hasFeed
      ? 'Latest posts from Commanders beat reporters.'
      : 'The beat reporters who cover this team every day. Click any card to visit their profile.'
    }
  </p>

  <div class="handles-grid">
    {config.reporters.map(r => (
      <a href={r.profileUrl} target="_blank" rel="noopener noreferrer"
         class="handle-card"
         aria-label={`${r.name} — ${r.outlet} (opens ${r.platform === 'x' ? 'X / Twitter' : 'Bluesky'} profile)`}>
        <span class="handle-platform" aria-hidden="true">
          {r.platform === 'x' ? 'View on X' : 'View on Bluesky'}
        </span>
        <span class="handle-at">@{r.handle}</span>
        <span class="handle-name">{r.name}</span>
        <span class="handle-outlet">{r.outlet}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .voices-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 16px;
    margin-bottom: 4px;
  }
  .section-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0;
    margin: 0;
  }
  .voices-mode-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-4);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 5px;
  }
  .voices-sub {
    font-size: 13px;
    color: var(--text-3);
    margin-bottom: 16px;
  }
  .handles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
  @media (min-width: 500px) {
    .handles-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 900px) {
    .handles-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .handle-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
    position: relative;
  }
  .handle-card:hover {
    border-color: var(--accent);
    background: var(--surface-3);
  }
  .handle-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .handle-platform {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-4);
  }
  .handle-at {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    padding-right: 60px; /* avoid platform badge overlap */
  }
  .handle-card:hover .handle-at { color: var(--accent); }
  .handle-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-2);
  }
  .handle-outlet {
    font-size: 11px;
    color: var(--text-4);
  }
</style>
