---
import type { IngestRun } from '../lib/types';
interface Props { lastRun: IngestRun | null; }
const { lastRun } = Astro.props;
const lastUpdated = lastRun?.completedAt ?? null;
const runStatus   = lastRun?.status ?? null;
---

<header class="mast">
  <div class="mast-inner">
    <div class="mast-left">
      <h1 class="mast-h1">
        <a href="/" class="mast-wordmark">
          <span class="mast-w1">BURGUNDY</span><span class="mast-w2">FEED</span>
        </a>
      </h1>
      <span class="mast-tagline">Washington's hourly newswire</span>
    </div>

    <div class="mast-right">
      <div class="display-toggle" role="group" aria-label="Display mode">
        <button class="dt-btn" id="dt-compact" type="button" aria-pressed="false">Compact</button>
        <button class="dt-btn" id="dt-visual"  type="button" aria-pressed="true">Visual</button>
      </div>
      <div class="mast-sync">
        <span class="sync-dot" id="syncDot"></span>
        <span class="sync-label" id="syncLabel"
              data-iso={lastUpdated ?? ''}
              data-status={runStatus ?? ''}>
          {lastUpdated ? 'Updated —' : 'News updates are temporarily unavailable'}
        </span>
      </div>
    </div>
  </div>
</header>

<script>
  // ── Display mode toggle ───────────────────────────────────────────────────
  (function () {
    const compactBtn = document.getElementById('dt-compact') as HTMLButtonElement | null;
    const visualBtn  = document.getElementById('dt-visual')  as HTMLButtonElement | null;
    if (!compactBtn || !visualBtn) return;

    function setMode(mode: string) {
      const isCompact = mode === 'compact';
      document.documentElement.setAttribute('data-display', mode);
      compactBtn!.setAttribute('aria-pressed', String(isCompact));
      visualBtn!.setAttribute('aria-pressed', String(!isCompact));
      try { localStorage.setItem('bf-display-mode', mode); } catch {}
    }

    // Sync buttons to whatever the <head> script already applied
    const current = document.documentElement.getAttribute('data-display') ?? 'visual';
    setMode(current);

    compactBtn.addEventListener('click', () => setMode('compact'));
    visualBtn.addEventListener('click',  () => setMode('visual'));
  })();

  function relativeTime(iso: string): string {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    const ageMs   = Date.now() - d.getTime();
    const ageMins = Math.floor(ageMs / 60_000);
    const ageHrs  = Math.floor(ageMs / 3_600_000);
    if (ageMins <  1) return 'just now';
    if (ageMins < 60) return `${ageMins} minute${ageMins === 1 ? '' : 's'} ago`;
    if (ageHrs  === 1) return '1 hour ago';
    return `${ageHrs} hours ago`;
  }

  function exactTime(iso: string): string {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    return d.toLocaleString('en-US', {
      month: 'short', day: 'numeric',
      hour: 'numeric', minute: '2-digit', hour12: true,
    });
  }

  function updateLabel() {
    const label = document.getElementById('syncLabel') as HTMLElement | null;
    const dot   = document.getElementById('syncDot')   as HTMLElement | null;
    if (!label) return;

    const iso    = label.dataset.iso    ?? '';
    const status = label.dataset.status ?? '';

    if (!iso) {
      label.textContent = 'News updates are temporarily unavailable';
      if (dot) dot.classList.add('sync-dot--error');
      return;
    }

    const ageMs  = Date.now() - new Date(iso).getTime();
    const ageHrs = ageMs / 3_600_000;
    const rel    = relativeTime(iso);
    const exact  = exactTime(iso);

    if (ageHrs >= 2) {
      if (ageHrs >= 4) {
        label.textContent = `Stale — last updated ${rel}`;
        if (dot) dot.classList.add('sync-dot--error');
      } else {
        label.textContent = `Updated ${rel}`;
        if (dot) dot.classList.add('sync-dot--warn');
      }
    } else if (status === 'partially_successful') {
      label.textContent = `Updated ${rel} (some sources unavailable)`;
    } else {
      label.textContent = `Updated ${rel}`;
    }

    label.title = `Last updated: ${exact}`;
  }

  updateLabel();
  // Refresh the relative time once a minute
  setInterval(updateLabel, 60_000);
</script>

<style>
  .sync-dot--warn  { background: #f59e0b !important; animation: none !important; }
  .sync-dot--error { background: #ef4444 !important; animation: none !important; }
</style>

<style>
  .mast {
    position: relative;
    z-index: 200;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .mast-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* h1 resets — display:contents passes layout through to the child <a> */
  .mast-h1 { display: contents; }

  /* ── Wordmark ── */
  .mast-left {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }
  .mast-wordmark {
    display: flex;
    align-items: baseline;
    gap: 0;
    text-decoration: none;
  }
  .mast-w1 {
    font-family: var(--font-display, 'Barlow Condensed', 'Arial Narrow', sans-serif);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text);
    line-height: 1;
  }
  .mast-w2 {
    font-family: var(--font-display, 'Barlow Condensed', 'Arial Narrow', sans-serif);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--accent);
    line-height: 1;
  }
  .mast-tagline {
    display: none;
    font-size: 11px;
    font-weight: 400;
    color: var(--text-3);
    letter-spacing: 0.01em;
    white-space: nowrap;
    padding-left: 14px;
    border-left: 1px solid var(--border);
  }
  @media (min-width: 500px) { .mast-tagline { display: block; } }

  /* ── Right side ── */
  .mast-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mast-sync {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .sync-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
    flex-shrink: 0;
    animation: blink 2.5s ease-in-out infinite;
  }
  .sync-label {
    font-size: 11px;
    color: var(--text-3);
    white-space: nowrap;
    display: none;
  }
  @media (min-width: 420px) {
    .sync-label { display: block; }
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.25; }
  }

  /* ── Display mode toggle ── */
  .display-toggle {
    display: flex;
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .dt-btn {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 9px;
    background: transparent;
    border: none;
    color: var(--text-4);
    cursor: pointer;
    font-family: inherit;
    line-height: 1;
    transition: background 0.12s, color 0.12s;
  }
  .dt-btn + .dt-btn { border-left: 1px solid var(--border); }
  .dt-btn[aria-pressed="true"] {
    background: var(--accent);
    color: #fff;
  }
  .dt-btn:hover:not([aria-pressed="true"]) {
    background: var(--surface-2);
    color: var(--text-2);
  }

</style>
