---
import TeamDates          from './TeamDates.astro';
import Schedule           from './Schedule.astro';
import TeamStats          from './TeamStats.astro';
import TransactionTracker from './TransactionTracker.astro';
import DivisionStandings  from './DivisionStandings.astro';
import InjuryReport       from './InjuryReport.astro';
import OpponentPreview    from './OpponentPreview.astro';
import type { EspnTransaction } from '../lib/espn';
import type { InjuredPlayer }   from '../lib/injuries';
import type { OpponentInfo }    from '../lib/opponent';

interface Props {
  dates:      any;
  schedule:   any;
  stats:      any;
  players:    any;
  txItems?:   EspnTransaction[];
  txLabel?:   string;
  showTx?:    boolean;
  standings?: any[];
  injuries?:  InjuredPlayer[];
  opponent?:  OpponentInfo | null;
}

const { dates, schedule, stats, players,
        txItems = [], txLabel = '', showTx = false,
        standings = [], injuries = [], opponent = null } = Astro.props;
---

<div class="rail">
  {showTx && txItems.length > 0 && (
    <div class="rail-section" id="transactions">
      <TransactionTracker items={txItems} label={txLabel} />
    </div>
  )}
  {opponent
    ? <div class="rail-section"><OpponentPreview opponent={opponent} /></div>
    : <div id="rail-opponent-mount"></div>
  }
  <div class="rail-section" id="rail-schedule">
    <Schedule schedule={schedule} />
  </div>
  {standings.length > 0 && (
    <div class="rail-section">
      <DivisionStandings entries={standings} />
    </div>
  )}
  <div class="rail-section">
    <TeamStats stats={stats} players={players} />
  </div>
  {injuries.length > 0
    ? <div class="rail-section"><InjuryReport players={injuries} /></div>
    : <div id="rail-injury-mount"></div>
  }
  <div class="rail-section">
    <TeamDates dates={dates} />
  </div>
</div>

<style>
  .rail {
    position: sticky;
    top: 56px;
    padding-top: 8px;
    padding-bottom: 32px;
    align-self: start;
  }
  .rail-section + .rail-section {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 2px solid var(--border);
  }
</style>
